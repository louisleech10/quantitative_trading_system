{
  "metadata": {
    "name": "momentum_pump_12h",
    "created_at": "2025-06-19T22:14:49.165333",
    "version": "1.0"
  },
  "config": {
    "name": "Momentum Pump Detection (12h)",
    "description": "Detect momentum pumps in 12-hour timeframe",
    "timeframe": "12h",
    "start_date": "2022-01-01",
    "end_date": "2022-12-31",
    "lookback_periods": 100,
    "forward_periods": 6,
    "sample_limit": 500,
    "min_volume": 1000000,
    "exclude_new_listing_days": 7,
    "initial_conditions": [
      {
        "condition_type": "price",
        "parameter": "price_change",
        "operator": ">=",
        "value": 0.1,
        "description": "Price pump >= 10%"
      },
      {
        "condition_type": "volume",
        "parameter": "volume",
        "operator": ">=",
        "value": 1000000,
        "description": "Volume >= 1M USDT"
      }
    ],
    "advanced_conditions": [
      {
        "condition_type": "price",
        "parameter": "future_max_drawdown",
        "operator": ">=",
        "value": -0.05,
        "description": "Max drawdown <= 5%"
      }
    ],
    "negative_sampling": true,
    "positive_negative_ratio": 2.0,
    "is_default": true
  }
}