{
  "registry_version": 2,
  "schema_version": 1,
  "cutoff_ts": "2026-07-23T00:00:00Z",
  "docs": {
    "_note": "本物件是 P1-6 audit 事件、欄位、枚舉與常數的唯一真相源；其餘資料容器不放說明文字。",
    "purpose": "P1-6 委員未結案債狀態機的 audit 契約。",
    "cutoff_ts": "cutoff 之前的事件視為 legacy；測試覆寫必須綁 GOVERNANCE_TEST_HARNESS=1。",
    "debt_event_required_fields": "只適用 debt_events；non_debt_legacy_events 不套用 sequence/producer。",
    "event_id": "uuid，全域唯一；重複時 fail-closed 拒寫。",
    "sequence": "由 audit_append.sh 以 mkdir 原子鎖分配；白名單事件的 gap/duplicate 由 ledger fail-closed。",
    "producer": "由 audit_append.sh 強制填入，呼叫端不得指定。",
    "origin_script": "邏輯來源，須屬於 allowed_origin_scripts。",
    "actor": "呼叫端提供的留痕字串。",
    "lock_mode": "sources.lock 的模式；review 才能進入正常銷帳。",
    "brief_sha256_norm_algo": "sha256(unify_newline(content) 後逐行移除行尾空白，再以 LF 連接)。",
    "result_state": "三值：success＝CLI 成功且產出非空且（findings-kind 時）格式合規；format-failed＝CLI 成功且產出非空但格式不合規（非空 output_sha256，可同輪重派，不可銷帳）；failed＝CLI 失敗或產出空（output_sha256 空字串）。",
    "unknown_event_policy": "post-cutoff 出現於 P16 命名空間但未登記的事件，fail-closed 拒認。",
    "family_valued_fields": "列於 family_valued_fields 的欄位值必須來自 governance_families.json。",
    "spec_non_event_tokens": "SPEC 會提及但不是事件名的 P16 token。",
    "event_object_allowed_keys": "debt event 物件只允許此白名單中的鍵。",
    "required_fields_per_event": "每事件的必要欄位；fields 必須是其超集。",
    "family_field_name_patterns": "用於檢查新增 family 欄位是否登記到 family_valued_fields。",
    "audit_log_path": "audit append-only log 的 repo 相對路徑。",
    "fragment_scan_prefixes": "命名空間片段掃描前綴。",
    "fragment_scan_allow_tokens": "已知不是事件名的既有腳本識別字。"
  },
