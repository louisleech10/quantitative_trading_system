#!/usr/bin/env bash
# pre-push — push 前跑治理檢查(委派 scripts/gov_check.sh),未過拒絕 push。
#
# 為什麼在這裡:branch protection 在「私有 repo + 免費方案」不生效(GitHub 顯示 Not enforced),
#   CI 只能「push 後亮紅」擋不住 main。本 hook 把守衛檢查前移到 push 之前 = 壞的推不上去。
# 檢查內容**不在此複製**,一律委派 gov_check.sh(單一真相源,避免兩處漂移)。
# 誠實邊界:`git push --no-verify` 可繞過 → **擋粗心不防蓄意**(符合本 repo 威脅模型:擋意外 90-95%)。
# 🔴 CI 已於 2026-08-13 全數刪除(連續五次全紅、無人查看=零保護純噪音)
#   ⇒ 本 hook 委派的 gov_check.sh 是**唯一防線**,跨平台盲區不再有兜底。理由見 gov_check.sh 檔頭。
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$ROOT" || exit 1

# 逃生口(明示且留痕;緊急時用)——VERDICTGATE C-7：一律寫 audit governance_bypass（現行為靜默 ⇒ 改留痕）
if [ "${GOVERNANCE_SKIP_PREPUSH:-}" = "1" ]; then
  [ -f scripts/audit_append.sh ] && bash scripts/audit_append.sh --event governance_bypass --field hook=pre-push \
    --field "reason=GOVERNANCE_SKIP_PREPUSH=1 by $(git config user.name 2>/dev/null || echo unknown)" \
    --field actor=pre-push --field origin_script=git_hooks/pre-push >/dev/null 2>&1 \
    || echo "pre-push: ⚠ 逃生口留痕失敗（audit_append）" >&2
  echo "pre-push: GOVERNANCE_SKIP_PREPUSH=1 → 略過治理檢查(緊急逃生口;已寫 audit governance_bypass)" >&2
  exit 0
fi

# ── VERDICTGATE Task 3.3：由 pre-push stdin 取 push range（每行 <local ref> <local sha> <remote ref> <remote sha>）──
#   remote sha 全零（新 ref）⇒ range＝<local sha>（全部可達）；local sha 全零（--delete）⇒ 該行跳過；
#   多行逐行驗；零行（某些客戶端）⇒ 回退 @{u}..HEAD；小 commit 視窗之幽靈過濾以本次全部 local sha 為可達目標。
#   v7 之 `HEAD --not --remotes` 在第二 remote 已含本地 commit 時待驗集合變空（COMPOSER-R7-P1-01）⇒ 改讀 stdin。
_pp_ranges=""; _pp_locals=""; _pp_zero='0000000000000000000000000000000000000000'
while read -r _lref _lsha _rref _rsha; do
  [ -n "${_lsha:-}" ] || continue
  [ "${_lsha}" = "${_pp_zero}" ] && continue
  if [ "${_rsha:-}" = "${_pp_zero}" ] || [ -z "${_rsha:-}" ]; then _r="${_lsha}"; else _r="${_rsha}..${_lsha}"; fi
  _pp_ranges="${_pp_ranges}${_pp_ranges:+ }${_r}"; _pp_locals="${_pp_locals}${_pp_locals:+,}${_lsha}"
done
if [ -z "${_pp_ranges}" ]; then
  if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then _pp_ranges='@{u}..HEAD'; _pp_locals="$(git rev-parse HEAD)"; fi
fi
export VG_PUSH_RANGES="${_pp_ranges}" VG_PUSH_LOCALS="${_pp_locals}"

[ -f scripts/gov_check.sh ] || {
  echo "pre-push: scripts/gov_check.sh 缺失 → fail-closed 拒 push" >&2; exit 1; }

# ── 🔴 2026-08-14 使用者定：pre-push 改為秒級 ────────────────────────────
# 使用者原話：「我只要 commit 和 push 是幾秒鐘內的事情」。
#
# 為何可以改（**前提變了，不是放寬標準**）：
#   · 舊設計把**全套 governance pytest**（實測 920 秒／15 分 20 秒）放在此處，
#     理由是「CI 已刪，這是唯一防線」。
#   · 2026-08-14 實測揭露該前提的缺口：那 920 秒跑的是 `pytest tests/governance`，
#     **只涵蓋治理腳本**；`tests/momentum`／`api`／`feature_engineering` 等
#     **2,445 條量化測試一條都沒跑**。它守的不是產品。
#   · 同日使用者裁定**回量化主線、治理留現狀不再擴建** ⇒ 治理腳本的改動頻率趨近零，
#     而每次推送仍付 15 分鐘。**成本與風險完全不成比例。**
#
# 現行：pre-push 只跑 `--fast`（shell 語法 ＋ 本次改動之治理文件格式，實測秒級）。
#
# 🔴 **移走的東西沒有消失，改為明示的手動關卡**：
#   · 動到 `scripts/`／`tests/governance/` 之後，收 epic 前跑一次
#     `bash scripts/gov_check.sh --no-probe`（丟背景，十分鐘級）
#   · 本輪之前的既有紀律（commit 前跑受影響測試子集）不變
#
# 🔴 **誠實邊界**：這是**降低防護以換取可用性**的取捨，不是「其實不需要」。
#   跨平台盲區（BSD/GNU `realpath`、`stat -f %m` vs `-c %Y`）現在**沒有任何東西擋**。
#   若日後回頭大改治理，應把此段改回 `--no-probe`。
_GC_MODE="--fast"
echo "pre-push: 委派 scripts/gov_check.sh ${_GC_MODE}（秒級；全套已改為手動關卡，理由見本檔註解）…"
if ! bash scripts/gov_check.sh "${_GC_MODE}"; then
  echo "" >&2
  echo "pre-push: ✗ 治理快閘未過 → 拒 push。" >&2
  echo "  修好再推;確有必要時 GOVERNANCE_SKIP_PREPUSH=1 git push。" >&2
  exit 1
fi

echo "pre-push: ✓ 放行 push"
# 🔴 2026-09-05 收窄（使用者：「要跑那麼久就要記得不要又開來用；之前你就改幾行，
#   然後一天花十幾小時在跑這種東西」）。
#   原文寫「動過 scripts/ 或 tests/governance/ 者」——那幾乎涵蓋所有改動，而它每次 push
#   都跳出來，於是主控端照它跑了 53 分鐘的全套。CLAUDE.md:135 的條件其實窄得多
#   （「只有動 gate.sh/cx_run.sh 這類共用控制流才需跑全套」）。兩處矛盾 ⇒ 以窄的為準。
echo "  提醒：全套 governance pytest 不在此執行，且**小時級**（實測 3220s／1749 條）。"
echo "     🔴 只有動 gate.sh／cx_run.sh／gov_check.sh 這類**共用控制流**才需跑，"
echo "        且只在**收 epic 前跑一次**（丟背景）。改幾行腳本不必跑。"
exit 0
