#!/usr/bin/env bash
# commit-msg — 掃描 commit subject+body 的 operational claim。
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$ROOT" || exit 1
msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: 缺少 commit message 檔" >&2
  exit 1
fi
py="venv/bin/python"
[ -x "$py" ] || py="$(command -v python3 || command -v python)"  # 無 venv(如 CI)→ 系統 python3
checker="scripts/verification_claim_check.py"
if [ -z "$py" ] || [ ! -f "$checker" ]; then
  echo "commit-msg: python(venv 或系統)或 verification_claim_check.py 缺失" >&2
  exit 1
fi
# G-7 前移（S6.1）：staged 含 scope 外路徑而訊息無 Governance-Scope trailer ⇒ 當場擋。
# 🔴 放在 exec **之前**：exec 會取代本行程，寫在後面等於永遠不執行。
# 🔴 2026-09-05 使用者裁定：G-7 改為**不擋**（warn-only）。
#   理由（實測，非偏好）：G-7 的 51 條 scope 內量化路徑＝0；硬保護集與量化主線零交集；
#   而它對量化碼的判決恆為「未宣告」（一次全跑列出 501 檔、其中 93 個是量化主線）
#   ⇒ 恆真的告警不是檢查，是常數。它保護的 GOVB1 是 DRAFT／從未實作／2026-08-14 已擱置。
#   使用者原話：「commit 和 push GitHub 都要幾秒就上去」。
if [ -f scripts/g7_trailer_precheck.sh ]; then
  bash scripts/g7_trailer_precheck.sh "$msg_file" || true
fi

# ── VERDICTGATE Task 3.2：Ticket-Batch trailer 閘（fail-closed；與 G-7 為兩條獨立呼叫、不共用回傳，SPEC C-2）──
#   staged 含生產碼（momentum|api|frontend/src）⇒ 訊息最末段須有 `Ticket-Batch: <root>/b<N>`（token 900s 內有效）
#   或 `Ticket-Batch: small`（≤3 檔且不含 factories/protocols/config）。逃生口 GOVERNANCE_SKIP_COMMITMSG=1
#   放行**但**寫 audit governance_bypass（C-7）。本檢查在 exec 之前。
if [ -f scripts/ticket_batch_check.sh ]; then
  if [ "${GOVERNANCE_SKIP_COMMITMSG:-}" = "1" ]; then
    bash scripts/audit_append.sh --event governance_bypass --field hook=commit-msg \
      --field "reason=GOVERNANCE_SKIP_COMMITMSG=1 by $(git config user.name 2>/dev/null || echo unknown)" \
      --field actor=commit-msg --field origin_script=git_hooks/commit-msg >/dev/null 2>&1 \
      || echo "commit-msg: ⚠ 逃生口留痕失敗（audit_append）" >&2
    echo "commit-msg: GOVERNANCE_SKIP_COMMITMSG=1 → 略過 Ticket-Batch 閘（已寫 audit governance_bypass）" >&2
  else
    bash scripts/ticket_batch_check.sh --msg "$msg_file"
    _tb_rc=$?          # 🔴 rc 直接取，禁經 pipe
    if [ "${_tb_rc}" -ne 0 ]; then
      exit 2
    fi
  fi
fi

exec "$py" "$checker" --commit-msg "$msg_file"
