#!/usr/bin/env bash
# pre-commit — 掃描 staged HANDOFF/handoffs/docs markdown 的 claim-object。
set -u
set -o pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$ROOT" || exit 1
py="venv/bin/python"
[ -x "$py" ] || py="$(command -v python3 || command -v python)"  # 無 venv(如 CI)→ 系統 python3
checker="scripts/verification_claim_check.py"
if [ -z "$py" ] || [ ! -f "$checker" ]; then
  echo "pre-commit: python(venv 或系統)或 verification_claim_check.py 缺失" >&2
  exit 1
fi

# index-only 尾隨空白移除（不碰工作樹；fenced/hard-break/表格列保留）
_strip_staged_trailing_ws() {
  local rel="$1"
  local old_sha new_sha mode tmp_blob tmp_out py_rc
  old_sha="$(git rev-parse ":${rel}" 2>/dev/null)" || return 0

  tmp_blob="$(mktemp)"
  tmp_out="$(mktemp)"
  if ! git cat-file blob ":${rel}" >"$tmp_blob" 2>/dev/null; then
    rm -f "$tmp_blob" "$tmp_out"
    return 0
  fi

  py_rc=0
  "$py" -c '
import sys

SKIP_EXIT = 2

def strip_trailing_ws(content):
    lines = content.splitlines(keepends=True)
    if not lines and content:
        lines = [content]
    out = []
    in_fence = False
    for line in lines:
        stripped_line = line.rstrip("\r\n")
        newline = line[len(stripped_line):]
        fence_toggle = stripped_line.strip().startswith("```")
        if in_fence:
            out.append(line)
            if fence_toggle:
                in_fence = False
            continue
        if fence_toggle:
            in_fence = True
            out.append(line)
            continue
        if stripped_line.startswith("|") and "|" in stripped_line[1:]:
            out.append(line)
            continue
        # 剛好兩空白 = Markdown hard break，保留
        if stripped_line.endswith("  ") and not stripped_line.endswith("   "):
            out.append(line)
            continue
        trimmed = stripped_line.rstrip(" \t")
        out.append(trimmed + newline)
    return "".join(out)

raw_bytes = sys.stdin.buffer.read()
try:
    raw = raw_bytes.decode("utf-8")
except UnicodeDecodeError:
    sys.stdout.buffer.write(raw_bytes)
    sys.exit(SKIP_EXIT)

result = strip_trailing_ws(raw)
if raw.endswith("\n") and result and not result.endswith("\n"):
    result += "\n"
sys.stdout.buffer.write(result.encode("utf-8"))
' <"$tmp_blob" >"$tmp_out" || py_rc=$?
  rm -f "$tmp_blob"

  # 非 UTF-8 / decode skip：不改 index
  if [ "$py_rc" -eq 2 ]; then
    rm -f "$tmp_out"
    return 0
  fi
  if [ "$py_rc" -ne 0 ]; then
    rm -f "$tmp_out"
    return 0
  fi

  new_sha="$(git hash-object -w --stdin <"$tmp_out")" || {
    rm -f "$tmp_out"
    return 0
  }
  rm -f "$tmp_out"

  if [ "$old_sha" != "$new_sha" ]; then
    mode="$(git ls-files -s -- "$rel" 2>/dev/null | awk "{print \$1; exit}")"
    [ -z "$mode" ] && mode="100644"
    git update-index --cacheinfo "$mode" "$new_sha" "$rel" 2>/dev/null || true
  fi
}

while IFS= read -r -d '' rel; do
  [ -n "$rel" ] || continue
  case "$rel" in
    HANDOFF.md|handoffs/*.md|docs/*.md) _strip_staged_trailing_ws "$rel" ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# 白話說明同步「提醒」（2026-08-05 使用者要求「想辦法能確保自己更新」）
# 🔴 **本層刻意不擋 commit**：若說明檔這次確實無需更動，硬擋會逼人養成用逃生口的習慣，
#    反而使機制失效。真正的強制在 pre-push（gov_check 4/4，時序判準，繞不過去）。
#    本層的價值＝在**當下**提醒，而非等到 push 時 commit 訊息都寫完了才發現。
[ -f scripts/plain_docs_sync_check.sh ] && bash scripts/plain_docs_sync_check.sh --staged || true

# ── 文件錨點／死連結（scripts/check_doc_anchors.sh）────────────────────────
# 🔴 為何掛這裡而不是產出端（使用者 2026-08-14T18:40+08:00：「耗費時間太多也是原因」）：
#   實測 2026-08-14：全庫 3.61 秒、`--files HANDOFF.md` 窄跑 3.76 秒——**窄化省不到**，
#   因為成本在「建全庫標題索引」，而解析一條連結必須知道所有檔的所有標題。
#   ⇒ 掛 PostToolUse 技術上可行（它就是個 rc≠0 的檢查），但代價是**每一次 .md 編輯**
#     多 3.6 秒；本 session 的 .md 編輯次數是兩位數 ⇒ 分鐘級純摩擦。
#   ⇒ 改掛 commit 邊界，且只在真的有 .md 進 staged 時才跑（無 .md ⇒ 零成本）。
#   誠實邊界：這是**消費端**，不是產出端；死連結會活到 commit 當下才被發現。
#   🔴 本列刻意**不進** docs/GOV_ENFORCEMENT_REGISTRY.md：該表之「對應票」欄由封閉集合
#     鎖死（S1.1），非票標的白名單經集合相等測試鎖為使用者點名的兩個值。
#     為登記一支腳本而撬那道鎖，代價大於收益。判定記於
#     docs/GOV_ACTIVE_MECHANISMS.md「§七 腳本級掛載判定」。
if [ -f scripts/check_doc_anchors.sh ]; then
  _anchor_staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' 2>/dev/null | head -1)"
  if [ -n "${_anchor_staged}" ]; then
    bash scripts/check_doc_anchors.sh
    _anchor_rc=$?          # 🔴 rc 直接取，禁經 pipe（CLAUDE.md 明載）
    if [ "${_anchor_rc}" -ne 0 ]; then
      echo "pre-commit: 🔴 文件錨點檢查未過（新增死連結）——修掉或說明後再 commit" >&2
      exit 1
    fi
  fi
fi

# ── 狀態檔不得純檔尾追加（流水帳防治；使用者 2026-08-14 定）────────────────
# 病根：plain_docs_sync_check 只驗時序（其檔頭自述「可只改一字換綠燈」）
# ⇒ 最便宜的合規動作＝在檔尾追加一行日期註記 ⇒ 狀態檔長成流水帳
#   （HANDOFF.md 曾長到 495 行、白話說明 九份 514KB）。
# 本檢查強迫**回頭改寫現況段**，而不是往下堆。帳本（摩擦記錄／進度日誌／
# ROADMAP_DETAIL）不在受檢集合內——對它們而言追加是正確形態。
if [ -f scripts/no_append_only_check.sh ]; then
  bash scripts/no_append_only_check.sh --check
  _nao_rc=$?          # 🔴 rc 直接取，禁經 pipe
  if [ "${_nao_rc}" -ne 0 ]; then
    echo "pre-commit: 🔴 狀態檔為純檔尾追加 → 拒絕。改寫現況段，或把歷史寫進帳本。" >&2
    exit 1
  fi
fi

exec "$py" "$checker" --staged
