{
  "_doc": "NUMVIEW 事前登記判準與決定紀錄 schema（docs/NUMVIEW_SPEC.md Task 0.3、設計選擇⑥、R2-D）。於 Phase 1 任何量測收據產出前凍結；提交後不得修改（只准於任何收據產出前以 preregistered_criteria_v2.json 取代並刪本檔）。數值門檻只來自 threshold_kinds 所列四類（exact 集合比較、NaN 遮罩 exact、IC 正負號、float32 ulp），不自訂 atol／rtol。每份 handoffs/run_receipts/*-numview-*.json 記本檔位元組之 sha256 為 criteria_sha256。",
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "version",
      "schema",
      "cell_rules",
      "cell_definitions",
      "comparison_outputs",
      "material",
      "decision_rules",
      "decisions_schema",
      "threshold_kinds",
      "ulp_rule"
    ],
    "additionalProperties": false,
    "properties": {
      "_doc": {
        "type": "string"
      },
      "version": {
        "const": 1
      },
      "schema": {
        "type": "object"
      },
      "cell_rules": {
        "type": "object",
        "required": [
          "enumerate_from",
          "output_bars",
          "insufficient_history",
          "categories",
          "timeframe_order"
        ],
        "properties": {
          "enumerate_from": {
            "type": "string",
            "pattern": "kline_cache\\.h5$"
          },
          "output_bars": {
            "type": "integer",
            "minimum": 1
          },
          "insufficient_history": {
            "type": "object",
            "required": [
              "rule",
              "blocked_by",
              "record",
              "lower_threshold_allowed"
            ],
            "properties": {
              "blocked_by": {
                "const": "history"
              },
              "record": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "lower_threshold_allowed": {
                "const": false
              }
            }
          },
          "categories": {
            "type": "object",
            "required": [
              "A",
              "B",
              "C"
            ]
          },
          "timeframe_order": {
            "type": "string"
          }
        }
      },
      "cell_definitions": {
        "type": "object",
        "required": [
          "A",
          "B",
          "C"
        ],
        "properties": {
          "A": {
            "$ref": "#/$defs/short_window_cell"
          },
          "B": {
            "$ref": "#/$defs/short_window_cell"
          },
          "C": {
            "type": "object",
            "required": [
              "config_override",
              "output_window",
              "timeframes_rule"
            ],
            "properties": {
              "config_override": {
                "type": "object"
              },
              "output_window": {
                "const": "full_history"
              },
              "timeframes_rule": {
                "type": "object"
              }
            }
          }
        }
      },
      "comparison_outputs": {
        "type": "object",
        "minProperties": 1,
        "patternProperties": {
          "^[a-z][a-z0-9_]*$": {
            "type": "object",
            "required": [
              "task",
              "reference",
              "variant",
              "receipt",
              "rows_key",
              "columns"
            ],
            "properties": {
              "task": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "variant": {
                "type": "string"
              },
              "receipt": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "rows_key": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "report_only": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "material": {
        "type": "object",
        "required": [
          "components",
          "tau_b",
          "non_finite_statistic_verdict",
          "component_threshold_kinds",
          "applicability",
          "zero_selected_columns",
          "report_only"
        ],
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "tau_b": {
            "type": "object",
            "required": [
              "pairs",
              "undefined_verdict",
              "undefined_cases"
            ],
            "additionalProperties": false,
            "properties": {
              "pairs": {
                "const": "both_finite"
              },
              "undefined_verdict": {
                "const": "material"
              },
              "undefined_cases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "non_finite_statistic_verdict": {
            "const": "material"
          },
          "component_threshold_kinds": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "exact_set",
                "nan_mask_exact",
                "ic_sign",
                "float32_ulp"
              ]
            }
          }
        }
      },
      "decision_rules": {
        "type": "object",
        "required": [
          "d_icpage_arm",
          "d_postic",
          "d_mtf",
          "d_memmap",
          "d_winsor_dtype",
          "d_codec",
          "d_l2",
          "d_research"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^d_[a-z0-9_]+$": {
            "$ref": "#/$defs/decision_rule"
          }
        }
      },
      "decisions_schema": {
        "type": "object"
      },
      "threshold_kinds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "exact_set",
            "nan_mask_exact",
            "ic_sign",
            "float32_ulp"
          ]
        }
      },
      "ulp_rule": {
        "type": "object",
        "required": [
          "expression",
          "threshold_kind",
          "required_oracle_cases"
        ],
        "properties": {
          "threshold_kind": {
            "const": "float32_ulp"
          }
        }
      },
      "comparison_outputs_doc": {
        "type": "string"
      },
      "decision_rules_doc": {
        "type": "string"
      }
    },
    "$defs": {
      "short_window_cell": {
        "type": "object",
        "required": [
          "min_history_bars",
          "output_bars",
          "config_override",
          "timeframes_rule",
          "generation"
        ],
        "properties": {
          "min_history_bars": {
            "type": "integer",
            "minimum": 1
          },
          "output_bars": {
            "type": "integer",
            "minimum": 1
          },
          "config_override": {
            "type": "object",
            "not": {
              "required": [
                "preset"
              ]
            }
          },
          "timeframes_rule": {
            "type": "object"
          },
          "generation": {
            "type": "object",
            "required": [
              "entry",
              "ic_engine_config",
              "ic_threshold",
              "label_horizon",
              "cleanup_raw"
            ]
          }
        }
      },
      "decision_rule": {
        "type": "object",
        "required": [
          "label",
          "trigger",
          "choices",
          "candidate_conditions"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "trigger": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "always",
                  "any_true",
                  "any_nonzero"
                ]
              },
              "receipt": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "rows_key": {
                "type": "string"
              },
              "where": {
                "type": "object"
              },
              "field": {
                "type": "string"
              }
            },
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "any_true",
                    "any_nonzero"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "kind",
                "receipt",
                "rows_key",
                "where",
                "field"
              ]
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "candidate_conditions": {
            "type": "object"
          }
        }
      }
    }
  },
  "cell_rules": {
    "_doc": "量測格定義規則（SPEC Task 0.4／0.5、§V 格子、設計選擇⑧）：一律自 kline_cache.h5 列舉 symbol×tf，不寫死 symbol、週期、24h 或 UTC；窗以根數定義。",
    "enumerate_from": "data_cache/feature_klines/kline_cache.h5",
    "output_bars": 500,
    "categories": {
      "A": "每個 symbol×tf 一格：單週期短窗（timeframes 恰一項）；設定＝cell_definitions.A。",
      "B": "每個具 ≥2 週期之 symbol 一格：timeframes＝該 symbol 全部週期依週期長度升冪，首項（最細）＝主週期、全部＝訓練週期；設定＝cell_definitions.B。",
      "C": "每個 symbol×tf 一格：生產預設全特徵設定（config_override 之外全取生產預設設定檔）於全史；本機不可跑（記憶體守護具名終止）者該 tf 全列 blocked-by 硬體（SPEC Task 0.4 邊界①）。"
    },
    "timeframe_order": "週期長度以 pandas.Timedelta(週期字面) 解析之秒數升冪；不可解析之週期字面 ⇒ 列舉拒收（不猜測）。",
    "insufficient_history": {
      "rule": "格 A／B：任一所涉週期於 kline_cache.h5 之根數 < cell_definitions.<格類>.min_history_bars ⇒ 該格 blocked（history），記各週期根數與理由，不降門檻、不以較短窗冒充同格。輸出段＝主週期最後 output_bars 根（起點＝倒數第 output_bars 根之時間戳、終點＝最後一根之時間戳）；min_history_bars＝output_bars＋平穩化校準長度 N 之最大預設值（momentum/FeatureEngineering/feature_config.py CALIBRATION_BARS_INTRADAY_DEFAULT＝1000，日內週期之預設；一日以上之預設 500 較小，取大者使任一週期皆可校準）。",
      "blocked_by": "history",
      "record": [
        "bar_counts",
        "reason"
      ],
      "lower_threshold_allowed": false
    }
  },
  "cell_definitions": {
    "_doc": "格之生成定義（凍結腳本 generate_cell、估時器單格實測、Phase 1 探針共用同一定義）。config_override＝傳給 FeatureFactory 設定解析之覆寫（未列之鍵取生產預設設定檔）；timeframes 之 primary／training 由格描述子依 timeframes_rule 填入。A／B 之設定＝PRE-PROV replace 格同型之輕量真實設定（tests/feature_engineering/preprov_helpers.py h1_replace_stat_on：mode=replace、分數差分與 ADF 差分開、縮尾開），post-IC rank／zscore 依生產預設（不明示關閉，同 PRE-PROV ic_first_default），gaussian 預設關。",
    "A": {
      "min_history_bars": 1500,
      "output_bars": 500,
      "timeframes_rule": {
        "primary": "timeframes[0]",
        "training": "timeframes"
      },
      "generation": {
        "entry": "run_ic_first",
        "ic_engine_config": {
          "methods": [
            "spearman"
          ]
        },
        "ic_threshold": null,
        "label_horizon": "1_bar_forward_return",
        "cleanup_raw": false
      },
      "config_override": {
        "atomic_indicators": {
