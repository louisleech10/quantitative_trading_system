  "material": {
    "_doc": "設計選擇⑥＋R2-D：任一 NaN 遮罩差、任一 IC 正負號翻轉、IC 選欄倖存者集合任一進出、或（比較後無 IC 選欄步驟者，即 post-IC 輸出之比較）逐欄 IC 排序 Kendall τ-b < 1 或 τ-b 未定義 ⇒ material。τ-b 只對參照與變體 IC 皆有限之欄對計算；全 ties、全 NaN、有效對數 < 2 ⇒ τ-b 為 NaN ⇒ material（fail-closed），不得以 NaN < 1 為假判為未翻轉；一切以比較式判定之統計量結果非有限 ⇒ material。material 只觸發決定點，不自動改碼。",
    "components": [
      "nan_mask_diff",
      "ic_sign_flip",
      "survivor_set_change",
      "tau_b_below_1"
    ],
    "component_threshold_kinds": {
      "nan_mask_diff": "nan_mask_exact",
      "ic_sign_flip": "ic_sign",
      "survivor_set_change": "exact_set",
      "tau_b_below_1": "exact_set"
    },
    "applicability": {
      "nan_mask_diff": "all_comparisons",
      "ic_sign_flip": "all_comparisons_with_ic",
      "survivor_set_change": "comparisons_followed_by_ic_selection",
      "tau_b_below_1": "post_ic_comparisons_without_selection_step"
    },
    "zero_selected_columns": "not_material_and_tau_b_not_computed",
    "tau_b": {
      "pairs": "both_finite",
      "undefined_verdict": "material",
      "undefined_cases": [
        "all_ties",
        "all_nan",
        "fewer_than_2_pairs"
      ]
    },
    "non_finite_statistic_verdict": "material",
    "report_only": [
      "delta_ic_in_standard_errors"
    ]
  },
  "decision_rules_doc": "每個決定點：觸發條件（自所引收據列機械重算；fail-closed：欄缺、非 bool、非有限 ⇒ 觸發）→ 候選處置 → 候選須另滿足之條件。凡改特徵階段或公開輸出值之處置皆須使用者白話閘確認（user_ruling），量測觸發不自動改碼；2026-09-29 落盤 dtype 裁定不在任何決定之選項中。",
  "decision_rules": {
    "d_icpage_arm": {
      "label": "D-ICPAGE-ARM",
      "trigger": {
        "kind": "always"
      },
      "choices": [
        "lock"
      ],
      "candidate_conditions": {
        "lock": {
          "arm_source": "post_ic_entries.ic_first",
          "changes_public_output": true,
          "requires_user_ruling": true,
          "user_ruling_date": "2026-10-21",
          "report_only": [
            "task_1_1_arm_vs_float64_diffs",
            "task_1_1_ic_flips",
            "task_1_1_arm_wall_seconds",
            "g1_arm_copies_pairwise_equality"
          ]
        }
      }
    },
    "d_postic": {
      "label": "D-POSTIC",
      "trigger": {
        "kind": "any_true",
        "receipt": "postic_branchdiff",
        "rows_key": "rows",
        "where": {
          "branch": "polars"
        },
        "field": "material"
      },
      "choices": [
        "polars_float64",
        "retain"
      ],
      "candidate_conditions": {
        "polars_float64": {
          "requires_user_ruling": true,
          "changes_public_output": true,
          "candidate_rows": {
            "receipt": "postic_branchdiff",
            "rows_key": "rows",
            "where": {
              "branch": "polars_float64"
            }
          },
          "candidate_must": {
            "nan_mask_diff": "all_zero",
            "material": "all_false",
            "intermediate_dtypes": "all_float64"
          },
          "threshold_kind": "nan_mask_exact"
        },
        "retain": {
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise"
        }
      }
    },
    "d_mtf": {
      "label": "D-MTF",
      "trigger": {
        "kind": "any_true",
        "receipt": "precision_chain",
        "rows_key": "forks",
        "where": {
          "fork": "mtf_layer_dtype"
        },
        "field": "material"
      },
      "choices": [
        "unify",
        "retain"
      ],
      "candidate_conditions": {
        "unify": {
          "requires_user_ruling": true,
          "changes_feature_stage": true,
          "oracle": [
            "single_vs_multi_tf_same_column_bitwise",
            "independent_float64_within_1_ulp"
          ],
          "threshold_kind": "float32_ulp"
        },
        "retain": {
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise"
        }
      }
    },
    "d_memmap": {
      "label": "D-MEMMAP",
      "trigger": {
        "kind": "any_true",
        "receipt": "precision_chain",
        "rows_key": "forks",
        "where": {
          "fork": "memmap_merge_dtype"
        },
        "field": "material"
      },
      "choices": [
        "decouple",
        "retain"
      ],
      "candidate_conditions": {
        "decouple": {
          "requires_user_ruling": true,
          "changes_feature_stage": true,
          "oracle": [
            "forced_branches_bitwise_equal"
          ]
        },
        "retain": {
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise"
        }
      }
    },
    "d_winsor_dtype": {
      "label": "D-WINSOR-DTYPE",
      "trigger": {
        "kind": "any_true",
        "receipt": "precision_chain",
        "rows_key": "forks",
        "where": {
          "fork": "winsor_sigma_dtype"
        },
        "field": "material"
      },
      "choices": [
        "unify",
        "retain"
      ],
      "candidate_conditions": {
        "unify": {
          "requires_user_ruling": true,
          "changes_feature_stage": true,
          "oracle": [
            "sigma_quantile_same_return_dtype",
            "fracdiff_independent_within_1_ulp"
          ],
          "threshold_kind": "float32_ulp"
        },
        "retain": {
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise"
        }
      }
    },
    "d_codec": {
      "label": "D-CODEC",
      "trigger": {
        "kind": "any_nonzero",
        "receipt": "precision_chain",
        "rows_key": "codec_checks",
        "where": {},
        "field": "nonconforming_columns"
      },
      "choices": [
        "provenance",
        "retain"
      ],
      "halt": {
        "requires": {
          "rows_key": "codec_checks",
          "where": {
            "check": "raw_bss_lossless"
          },
          "field": "nonconforming_columns",
          "condition": "any_nonzero"
        },
        "verdict": "lossless_violation_stop_and_attribute",
        "note": "raw BYTE_STREAM_SPLIT 讀回逐位元不等＝無損宣稱之反例（SPEC Task 1.2 驗證 lossless_violation）：此時不得記錄任何 choice，Task 1.5 停下歸因；provenance 與 retain 之 requires_all 皆要求 raw_bss_lossless 全為 0，故兩者於此情況皆不成立（fail-closed）"
      },
      "candidate_conditions": {
        "provenance": {
          "requires_all": [
            {
              "rows_key": "codec_checks",
              "where": {
                "check": "name_inference"
              },
              "field": "nonconforming_columns",
              "condition": "any_nonzero"
            },
            {
              "rows_key": "codec_checks",
              "where": {
                "check": "raw_bss_lossless"
              },
              "field": "nonconforming_columns",
              "condition": "all_zero"
            }
          ],
          "requires_user_ruling": true,
          "changes_public_output": true,
          "anomaly_encoding": "float32_lossless"
        },
        "retain": {
          "requires_all": [
            {
              "rows_key": "codec_checks",
              "where": {},
              "field": "nonconforming_columns",
              "condition": "all_zero"
            }
          ],
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise",
          "register_in_identity": true
        }
      },
      "excluded_options": [
        "remove_lossy_encoding_changes_output_size_needs_separate_user_approval_and_spec_revision"
      ]
    },
    "d_l2": {
      "label": "D-L2",
      "trigger": {
        "kind": "any_nonzero",
        "receipt": "l2_arm_matrix",
        "rows_key": "cells",
        "where": {
          "kind": "B"
        },
        "field": "f32diff"
      },
      "choices": [
        "unify",
        "retain"
      ],
      "candidate_conditions": {
        "unify": {
          "requires": {
            "rows_key": "cells",
            "where": {
              "kind": "B"
            },
            "field": "f32diff",
            "condition": "any_nonzero"
          },
          "requires_user_ruling": true,
          "changes_feature_stage": true,
          "oracle": [
            "l5_l6_from_public_l2_bitwise"
          ]
        },
        "retain": {
          "requires": {
            "rows_key": "cells",
            "where": {
              "kind": "B"
            },
            "field": "f32diff",
            "condition": "all_zero"
          },
          "requires_user_ruling": false,
          "pin": "section_g_values_native_bitwise",
          "register": "contract_named_cells_with_nonzero_f32diff"
        }
      }
    },
    "d_research": {
      "label": "D-RESEARCH",
      "trigger": {
        "kind": "any_true",
        "receipt": "postic_branchdiff",
        "rows_key": "rows",
        "where": {
          "branch": "registry"
        },
        "field": "material"
      },
      "choices": [
        "retain",
        "unify"
      ],
      "candidate_conditions": {
        "retain": {
          "requires_user_ruling": false,
          "register": "contract_research_arms_with_unreachable_reason_and_measured_diff"
        },
        "unify": {
          "requires_user_ruling": true,
          "changes_feature_stage": true,
          "oracle": [
            "registry_zscore_vs_independent_float64_within_1_ulp"
          ],
          "threshold_kind": "float32_ulp",
          "cost_report": [
            "memory_ratio",
            "wall_time_ratio"
          ]
        }
      }
    }
  },
  "ulp_rule": {
    "_doc": "Phase 3 改核心分支之 oracle（SPEC §G 通過條件、R2-C）：逐格 1 ulp；取絕對值（負數之 np.spacing 為負）；NaN 遮罩 exact；測試須含正、負、零三類 oracle 值與 NaN 遮罩案。保留分支一律 values_native 逐位元相等，不得以量測上界作通過條件（R6-B）。",
    "expression": "np.abs(out - np.float32(oracle)) <= np.abs(np.spacing(np.float32(oracle)))",
    "threshold_kind": "float32_ulp",
    "required_oracle_cases": [
      "positive",
      "negative",
      "zero",
      "nan_mask"
    ]
  },
  "threshold_kinds": [
    "exact_set",
    "nan_mask_exact",
    "ic_sign",
    "float32_ulp"
  ],
  "decisions_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "criteria_sha256",
      "decisions",
      "measurement_limitations"
    ],
    "properties": {
      "criteria_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "decisions": {
        "type": "object",
        "required": [
          "d_icpage_arm",
          "d_postic",
          "d_mtf",
          "d_memmap",
          "d_winsor_dtype",
          "d_codec",
          "d_l2",
          "d_research"
        ],
        "additionalProperties": false,
        "properties": {
          "d_icpage_arm": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "required": [
                  "user_ruling"
                ],
                "properties": {
                  "label": {
                    "const": "D-ICPAGE-ARM"
                  },
                  "choice": {
                    "const": "lock"
                  },
                  "changes_public_output": {
                    "const": true
                  }
                }
              }
            ]
          },
          "d_postic": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-POSTIC"
                  },
                  "choice": {
                    "enum": [
                      "polars_float64",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_mtf": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-MTF"
                  },
                  "choice": {
                    "enum": [
                      "unify",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_memmap": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-MEMMAP"
                  },
                  "choice": {
                    "enum": [
                      "decouple",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_winsor_dtype": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-WINSOR-DTYPE"
                  },
                  "choice": {
                    "enum": [
                      "unify",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_codec": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-CODEC"
                  },
                  "choice": {
                    "enum": [
                      "provenance",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_l2": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-L2"
                  },
                  "choice": {
                    "enum": [
                      "unify",
                      "retain"
                    ]
                  }
                }
              }
            ]
          },
          "d_research": {
            "allOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "properties": {
                  "label": {
                    "const": "D-RESEARCH"
                  },
                  "choice": {
                    "enum": [
                      "retain",
                      "unify"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "measurement_limitations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "criteria_defect",
                "unforeseen_situation"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "$defs": {
      "record": {
        "type": "object",
        "required": [
          "label",
          "triggered",
          "choice",
          "changes_public_output",
          "changes_feature_stage",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "triggered": {
            "type": "boolean"
          },
          "choice": {
            "type": "string"
          },
          "changes_public_output": {
            "type": "boolean"
          },
          "changes_feature_stage": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "receipt",
                "rows_key",
                "row"
              ],
              "properties": {
                "receipt": {
                  "type": "string",
                  "minLength": 1
                },
                "rows_key": {
                  "type": "string",
                  "minLength": 1
                },
                "row": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "user_ruling": {
            "type": "object",
            "required": [
              "date",
              "quote"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "report": {
            "type": "object"
          },
          "committee_split": {
            "type": "boolean"
          },
          "split_resolution": {
            "enum": [
              "evidence",
              "stricter_with_residual"
            ]
          },
          "residual_id": {
            "type": "string",
            "pattern": "^NUMVIEW-R\\d+$"
          },
          "implemented_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "changed_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "group"
              ],
              "properties": {
                "group": {
                  "enum": [
                    "g1",
                    "g2",
                    "g3",
                    "legacy"
                  ]
                }
              }
            }
          },
          "approved_limits": {
            "type": "object"
          }
        }
      }
    }
  }
}
