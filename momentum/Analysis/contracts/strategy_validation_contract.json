        "universe_scope"
      ],
      "optional_keys": [],
      "types": {
        "status": ["str"],
        "reason": ["str"],
        "value": ["float", "null"],
        "n_paths_used": ["int", "null"],
        "n_paths_skipped": ["int", "null"],
        "n_candidates_invalid": ["int", "null"],
        "universe_scope": ["str", "null"]
      },
      "additional_properties": false
    },
