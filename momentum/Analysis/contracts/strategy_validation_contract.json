{
  "_doc": "GAP-1 策略驗證契約單一真相源（Task 2.1）。欄位/枚舉值只住本檔；SPEC/TODO/程式/測試不得複列。capability_status 不在此重新定義,以 capability_status_ref 指向 IC 契約(執行期 dereference,失敗即 raise)。頂層鍵恰為 16 個(見 docs/GAP1_STRATEGY_OVERFIT_TODO.md Task 2.1 + 延伸檔 A1-4/A1-7/A1-8/A1-13)。",
  "version": 1,
  "capability_status_ref": "momentum/Analysis/contracts/ic_report_contract.json#capability_status",
  "ledger_record_keys": {
    "_doc": "N 帳本 JSONL 之單列 schema。additional_properties:false ⇒ 未列鍵之 row 即非法(reason=ledger_row_invalid,計入 n_rows_rejected)。",
    "additional_properties": false,
    "keys": {
      "research_session_id": {"type": "str", "required": true},
      "dataset_key": {"type": "str", "required": true},
      "candidate_id": {"type": "str", "required": true},
      "evaluation_id": {"type": "str", "required": true},
      "attempt_index": {"type": "int", "required": true},
      "state": {"type": "str", "required": true},
      "metric_name": {"type": "str", "required": true},
      "metric_value": {"type": "float", "required": true},
      "metric_unit": {"type": "str", "required": true},
      "metric_valid": {"type": "bool", "required": true},
      "input_artifact_hash": {"type": "str", "required": true},
      "ts": {"type": "str", "required": true}
    }
  },
  "n_fields": [
    "n_candidates_considered",
    "n_evaluated",
    "n_valid_metrics",
    "n_failed_or_pruned",
    "n_is_lower_bound",
    "n_rows_rejected"
  ],
  "report_sections": {
    "_doc": "三關報告之五節 required_keys 逐字(A1-13);各節 additional_properties:false。",
    "eligibility": {
      "required_keys": [
        "eligible",
        "required_years_upper_bound",
        "available_years",
        "trials_budget",
        "trials_used",
        "target_sharpe",
        "n_source",
        "display_downgrade",
        "warning_text_key",
        "status",
        "reason"
      ],
      "optional_keys": [],
      "types": {
        "eligible": ["bool", "null"],
        "required_years_upper_bound": ["float", "null"],
        "available_years": ["float", "null"],
        "trials_budget": ["int", "null"],
        "trials_used": ["int", "null"],
        "target_sharpe": ["float", "null"],
        "n_source": ["str"],
        "display_downgrade": ["bool"],
        "warning_text_key": ["str"],
        "status": ["str"],
        "reason": ["str"]
      },
      "additional_properties": false
    },
    "min_btl": {
      "required_keys": [
        "status",
        "reason",
        "required_years_upper_bound",
        "available_years",
        "trials_budget",
        "trials_used",
        "target_sharpe"
      ],
      "optional_keys": [],
      "types": {
        "status": ["str"],
        "reason": ["str"],
        "required_years_upper_bound": ["float", "null"],
        "available_years": ["float", "null"],
        "trials_budget": ["int", "null"],
        "trials_used": ["int", "null"],
        "target_sharpe": ["float", "null"]
      },
      "additional_properties": false
    },
    "dsr": {
      "required_keys": [
        "status",
        "reason",
        "value",
        "sr0",
        "sr_obs_per_period",
        "n_trials_used",
        "variance_source",
        "n_independence"
      ],
      "optional_keys": [],
      "types": {
        "status": ["str"],
        "reason": ["str"],
        "value": ["float", "null"],
        "sr0": ["float", "null"],
        "sr_obs_per_period": ["float", "null"],
        "n_trials_used": ["int", "null"],
        "variance_source": ["str", "null"],
        "n_independence": ["str", "null"]
      },
      "additional_properties": false
    },
    "pbo": {
      "required_keys": [
        "status",
