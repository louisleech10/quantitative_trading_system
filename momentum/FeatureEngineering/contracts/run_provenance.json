{
  "_doc": "docs/FFDSTAR_SPEC.md 之逐欄執行紀錄與 run 身分契約（單一真相源）。各 values 由 Task 1.1 以碼證盤出實際離開路徑後填入，每值附 _sources（path:line，皆為寫入路徑內之紀錄函式呼叫且實參含該值字面）；§V 驗收格未產出之值列於 _unreachable 並附碼證理由。",
  "version": 2,
  "value_pattern": "^[a-z][a-z0-9_]*$",
  "files": {
    "raw": "provenance/raw_columns.parquet",
    "processed": "provenance/processed_columns.parquet"
  },
  "parquet_compression": "zstd",
  "record_columns": {
    "output_column": {
      "type": "str",
      "nullable": false,
      "_doc": "落盤欄名（FF-NAME v2 文法；tag_timeframe 後）；每列唯一"
    },
    "native_timeframe": {
      "type": "str",
      "nullable": false
    },
    "layer": {
      "type": "str",
      "nullable": true
    },
    "group_id": {
      "type": "str",
      "nullable": true,
      "_doc": "dead-drop 欄為來源群組 id；無群組者 null"
    },
    "terminal": {
      "type": "enum:terminal_values",
      "nullable": false
    },
    "parent_column": {
      "type": "str",
      "nullable": true,
      "_doc": "append 模式衍生欄之父欄落盤名；其餘 null"
    },
    "winsorization": {
      "type": "enum:step_status_values.winsorization",
      "nullable": false
    },
    "fractional_differencing": {
      "type": "enum:step_status_values.fractional_differencing",
      "nullable": false
    },
    "adf_differencing": {
      "type": "enum:step_status_values.adf_differencing",
      "nullable": false
    },
    "rank_transform": {
      "type": "enum:step_status_values.rank_transform",
      "nullable": false
    },
    "adaptive_zscore": {
      "type": "enum:step_status_values.adaptive_zscore",
      "nullable": false
    },
    "gaussian_normalize": {
      "type": "enum:step_status_values.gaussian_normalize",
      "nullable": false
    },
    "adf_pvalue": {
      "type": "float64",
      "nullable": true
    },
    "n": {
      "type": "int64",
      "nullable": true
    },
    "calibration_start": {
      "type": "str",
      "nullable": true,
      "_doc": "UTC ISO 8601，同 stable_start 表示"
    },
    "calibration_end": {
      "type": "str",
      "nullable": true
    },
    "fracdiff": {
      "type": "bool",
      "nullable": true
    },
    "d": {
      "type": "float64",
      "nullable": true
    },
    "adf_differenced": {
      "type": "int64",
      "nullable": true
    },
    "dstar_source": {
      "type": "enum:dstar_source_values",
      "nullable": true
    },
    "events": {
      "type": "list<str>",
      "nullable": false
    },
    "winsor_method": {
      "type": "str",
      "nullable": false,
      "_doc": "FFPROD Task 1.2：縮尾 applied ⇒ 實際 method（winsor_method_values）；其餘縮尾狀態 ⇒ winsor_method_record_values.status_map 之對應值"
    },
    "winsor_lower_q": {
      "type": "float64",
      "nullable": true,
      "_doc": "quantile 下分位端點（applied 且 method=quantile 時非空）"
    },
    "winsor_upper_q": {
      "type": "float64",
      "nullable": true
    },
    "winsor_sigma_k": {
      "type": "float64",
      "nullable": true,
      "_doc": "sigma 倍數（applied 且 method=sigma 時非空）"
    },
    "winsor_window": {
      "type": "int64",
      "nullable": true,
      "_doc": "滾動窗（本實例之有效窗；native 子實例為縮放後之窗）"
    },
    "winsor_min_periods": {
      "type": "int64",
      "nullable": true
    },
    "winsor_compute_dtype": {
      "type": "str",
      "nullable": true,
      "_doc": "縮尾滾動統計量之計算 dtype：quantile 一律 float64；sigma 於快速 numba 臂 float32、pandas 臂 float64（統計量其後轉 float32 成界線）"
    }
  },
  "winsor_effective_fields": [
    "winsor_method",
    "winsor_lower_q",
    "winsor_upper_q",
    "winsor_sigma_k",
    "winsor_window",
    "winsor_min_periods",
    "winsor_compute_dtype"
  ],
  "winsor_method_values": {
    "_doc": "縮尾 method 封閉值集；與 momentum/FeatureEngineering/contracts/numeric_view.json 之 winsor_method_values 須相同（run_provenance 讀用時核對，不符即拒）",
    "values": [
      "quantile",
      "sigma"
    ]
  },
  "winsor_method_record_values": {
    "_doc": "縮尾非 applied 之紀錄值；status_map＝縮尾步驟狀態（step_status_values.winsorization，applied 除外）→ 紀錄值",
    "values": [
      "disabled",
      "passthrough",
      "not_selected"
    ],
    "status_map": {
      "disabled": "disabled",
      "preprocessing_master_off": "disabled",
      "not_selected": "not_selected",
      "source_missing": "not_selected",
      "ratio_unsafe_skip": "passthrough"
    }
  },
