    "native_timeframe": {
      "type": "str",
      "nullable": false
    },
    "layer": {
      "type": "str",
      "nullable": true
    },
    "group_id": {
      "type": "str",
      "nullable": true,
      "_doc": "dead-drop 欄為來源群組 id；無群組者 null"
    },
    "terminal": {
      "type": "enum:terminal_values",
      "nullable": false
    },
    "parent_column": {
      "type": "str",
      "nullable": true,
      "_doc": "append 模式衍生欄之父欄落盤名；其餘 null"
