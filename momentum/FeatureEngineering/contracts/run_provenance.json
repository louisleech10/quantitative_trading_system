    "fracdiff": {
      "type": "bool",
      "nullable": true
    },
    "d": {
      "type": "float64",
      "nullable": true
    },
    "adf_differenced": {
      "type": "int64",
      "nullable": true
    },
    "dstar_source": {
      "type": "enum:dstar_source_values",
      "nullable": true
    },
    "events": {
      "type": "list<str>",
      "nullable": false
    }
  },
