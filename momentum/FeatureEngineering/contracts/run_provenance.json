      "nullable": false
    },
    "gaussian_normalize": {
      "type": "enum:step_status_values.gaussian_normalize",
      "nullable": false
    },
    "adf_pvalue": {
      "type": "float64",
      "nullable": true
    },
    "n": {
      "type": "int64",
      "nullable": true
    },
    "calibration_start": {
      "type": "str",
      "nullable": true,
      "_doc": "UTC ISO 8601，同 stable_start 表示"
    },
    "calibration_end": {
      "type": "str",
      "nullable": true
