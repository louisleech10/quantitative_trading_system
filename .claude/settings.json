{
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit",
      "Write",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(source venv/*)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/gate.sh:*)",
      "Bash(bash scripts/template_check.sh:*)",
      "Bash(bash scripts/coverage_check.sh:*)",
      "Bash(bash scripts/agent_preflight.sh:*)",
      "Bash(bash scripts/agent_postflight.sh:*)",
      "Bash(which *)",
      "Bash(open *)",
      "Bash(agy *)",
      "Bash(timeout * agy *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/gate_check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f HANDOFF.md ] && jq -Rs '{\"systemMessage\": (\"=== HANDOFF.md (自動注入) ===\\n\" + .)}' HANDOFF.md || echo '{}'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"[SYSTEM] Context 即將自動壓縮。壓縮前請確保：(1) 用 Write 工具更新 HANDOFF.md，記錄當前任務、下一步、決策、阻塞，保持 30 行以內。(2) 若無法立即更新，請在 compaction summary 開頭寫明需更新 HANDOFF.md 的內容，讓下個 session 的 Claude 第一件事就執行更新。\"}'"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"[SYSTEM] Context 即將手動壓縮。壓縮前請確保：(1) 用 Write 工具更新 HANDOFF.md，記錄當前任務、下一步、決策、阻塞，保持 30 行以內。(2) 若無法立即更新，請在 compaction summary 開頭寫明需更新 HANDOFF.md 的內容，讓下個 session 的 Claude 第一件事就執行更新。\"}'"
          }
        ]
      }
    ]
  }
}
