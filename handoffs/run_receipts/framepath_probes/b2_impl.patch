-def _fmt_sec(sec: float) -> str:
-    if sec >= 3600:
-        return f"{sec:.1f}s ({sec / 3600:.2f} hr)"
-    if sec >= 60:
-        return f"{sec:.1f}s ({sec / 60:.1f} min)"
-    return f"{sec:.2f}s"
-
-
-def _speedup_str(new_sec: float, ref_sec: float) -> str:
-    if ref_sec <= 0 or new_sec <= 0:
-        return "N/A"
-    ratio = ref_sec / new_sec
-    return f"{ratio:.2f}×"
