+def out_exclusion(repo: Path, out_dir: Optional[Path]) -> Optional[str]:
+    """本次 `--out` 位於 repo 內 ⇒ 排除其下未追蹤內容之 pathspec（前綴由參數導出）；位於 repo 外或未給 ⇒ None。"""
+    if out_dir is None:
