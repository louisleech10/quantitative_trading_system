+def _is_usefixtures(x: ast.AST) -> bool:
+    return isinstance(x, ast.Call) and isinstance(x.func, ast.Attribute) and x.func.attr == "usefixtures" \
+        and isinstance(x.func.value, ast.Attribute) and x.func.value.attr == "mark"
