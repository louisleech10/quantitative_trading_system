+def _run_subbatch(g: Any, root: Path, manifest_path: str, phase: int, base: str, out: Optional[Path],
+                  receipt: Path, max_seconds: Optional[float]) -> int:
+    schema = load_schema(root)
+    base_sha = _git_out(root, "rev-parse", "--verify", f"{base}^{{commit}}").strip()
+    head_sha = _git_out(root, "rev-parse", "HEAD").strip()
+    mpath = root / manifest_path
+    try:
+        mbytes = mpath.read_bytes()
+        manifest = json.loads(mbytes.decode("utf-8"))
+    except (OSError, ValueError) as exc:
+        raise TestregError(f"MANIFEST {manifest_path}: 不存在或不可解析") from exc
+    out = Path(out).resolve() if out is not None else \
+        Path(tempfile.gettempdir()) / f"testreg_run_p{phase}_{base_sha[:12]}"
+    out.mkdir(parents=True, exist_ok=True)
+    env = dict(os.environ, PYTHONPATH=str(root))
+    changed = _subbatch_changed(g, root, base_sha)
+    must = _seam("must_from_manifest")(root, manifest, phase)
+    sel = _seam("impact")(root, changed, must, previously_failed_from_summary(root))
+    files = [x["path"] for x in sel["selected"]]
+    collected: Dict[str, List[str]] = {}
+    incomplete: List[str] = []
+    for f in files:
+        try:
+            collected[f] = _subbatch_collect(g, f, root, env)
+        except TestregError as exc:
+            sys.stderr.write(f"{exc}\n")
+            collected[f] = []
+            incomplete.append(f)
+    expected = sorted(set().union(*(set(v) for v in collected.values())))
+    ledger_dir = root / schema["ledger"]["dir"]
+    # 時間預算自執行起算（收集不計）：首段至少執行一個檔，於兩次呼叫之間停下
+    runner = _SUBBATCH_RUNNER["runner"] = g.Runner(out, max_seconds, len(expected), ledger_dir=ledger_dir)
+    batch: Dict[str, Dict[str, str]] = {}
+    per_file: Dict[str, Dict[str, Any]] = {}
+    for f in files:
+        ids = collected[f]
+        if not ids:
+            per_file[f] = {"rc": -1, "reused": False}
+            continue
+        tag = f.replace("/", "_")
+        xml = out / "junit" / (tag + ".xml")
+        meta = xml.with_suffix(".meta.json")
+        before = (meta.stat().st_ino, meta.stat().st_mtime_ns) if meta.is_file() else None
+        key = g.state_key(root, f, phase, env) + "|" + "|".join(ids)
+        rc, res = runner.run(f, xml, root, env, None, (), key, ids, phase="run")
+        after = (meta.stat().st_ino, meta.stat().st_mtime_ns) if meta.is_file() else None
+        per_file[f] = {"rc": rc, "reused": before is not None and before == after}
+        if rc not in g.RUN_RC_OK or set(ids) - set(res):
+            incomplete.append(f)
+        batch.update({n: dict(v) for n, v in res.items() if n in ids})
+    not_passed = [n for n in expected if n in batch and batch[n].get("outcome") != "passed"]
+    anchor_res: Dict[str, Dict[str, str]] = {}
+    if not_passed:
+        wt = _base_worktree(g, root, out, base_sha)
+        base_env = dict(os.environ, PYTHONPATH=str(wt))
+        for f in dict.fromkeys(n.split("::", 1)[0] for n in not_passed):
+            ids = [n for n in not_passed if n.split("::", 1)[0] == f]
+            if not (wt / f).is_file():
+                continue
+            akey = "base|" + g.state_key(wt, f, phase, base_env) + "|" + "|".join(ids)
+            arc, ares = runner.run(f, out / "base_junit" / (f.replace("/", "_") + ".xml"), wt, base_env, ids, (),
+                                   akey, ids, phase="anchor")
+            anchor_res.update(g.anchor_usable(arc, ares, ids))
+    runner.progress("done", "", [], state="finished")
+    cls = g.classify(expected, batch, anchor_res)
+    results = {n: batch[n]["outcome"] for n in expected if n in batch}
+    rcpt: Dict[str, Any] = {
+        "manifest_path": manifest_path, "manifest_sha256": hashlib.sha256(mbytes).hexdigest(), "phase": phase,
+        "base": base_sha, "head": head_sha,
+        "inputs_digest": _subbatch_inputs_digest(g, root, base_sha, head_sha, hashlib.sha256(mbytes).hexdigest(),
+                                                 phase, schema),
+        "changed_paths": changed, "selection": sel, "files": per_file, "expected": expected, "results": results,
+        "incomplete_files": sorted(set(incomplete)), "missing": sorted(n for n in expected if n not in results),
+        "caused": sorted(cls["caused"]), "head_red": sorted(cls["head_red"]), "pass": False}
+    rcpt["pass"] = not rcpt["caused"] and not rcpt["missing"] and not rcpt["incomplete_files"]
+    errs = [*_seam("validate_shape")(rcpt, {"type": "types.subbatch_receipt"}, schema, "subbatch_receipt"),
+            *_subbatch_relation_errors(rcpt, collected)]
+    if errs:
+        raise TestregError(f"RUN 收據不合契約：{errs[:5]}")
+    rp = receipt if Path(receipt).is_absolute() else root / receipt
+    rp.parent.mkdir(parents=True, exist_ok=True)
+    rp.write_text(json.dumps(rcpt, ensure_ascii=False, indent=1, sort_keys=True) + "\n", encoding="utf-8")
+    sys.stdout.write(f"TESTREG run：files={len(files)} expected={len(expected)} incomplete={len(rcpt['incomplete_files'])} "
+                     f"missing={len(rcpt['missing'])} caused={len(rcpt['caused'])} head_red={len(rcpt['head_red'])} "
+                     f"pass={rcpt['pass']}\n")
+    return 0 if rcpt["pass"] else 1
 
 
