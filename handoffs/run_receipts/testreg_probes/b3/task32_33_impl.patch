+def _subbatch_changed(g: Any, root: Path, base: str) -> List[str]:
+    """changed_paths＝base 至工作樹之 diff ∪ 未追蹤檔，扣閘之 FP_EXCLUDES（handoffs／__pycache__／生成之已追蹤清冊）。"""
+    out = {p for p in _git_out(root, "diff", "--name-only", "--no-renames", base).splitlines() if p}
+    out |= {p for p in _git_out(root, "ls-files", "--others", "--exclude-standard", "-z").split("\0") if p}
+    return sorted(p for p in out if not g._fp_excluded(p))
+
+
+def _subbatch_collect(g: Any, test_file: str, cwd: Path, env: Mapping[str, str]) -> List[str]:
+    """完整收集（含類別方法與參數化）：逐行 nodeid 之輸出所需 verbosity 依 pytest.ini 之 addopts 而異（本 repo 之
+    addopts 含 -v ⇒ -qq；無 -v 之倉 ⇒ -q），兩者依序試，取第一個逐行印出 nodeid 者；皆無 ⇒ TestregError。"""
+    tail = ""
+    for q in ("-q", "-qq"):
+        g.restore_generated(cwd)
+        try:
+            proc = g._pytest(["--collect-only", q, "-p", "no:cacheprovider", test_file], cwd, env,
+                             timeout=g.COLLECT_TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired as exc:
+            raise TestregError(f"RUN {test_file} collect 逾 {g.COLLECT_TIMEOUT_SECONDS} 秒未返回") from exc
+        finally:
+            g.restore_generated(cwd)
+        ids = [ln.strip() for ln in proc.stdout.splitlines() if ln.startswith(test_file + "::")]
+        if proc.returncode == 0 and ids:
+            return ids
+        tail = (proc.stdout + proc.stderr)[-300:]
+    raise TestregError(f"RUN {test_file} 收集失敗或為空：{tail}")
+
+
+def _base_worktree(g: Any, root: Path, out: Path, base: str) -> Path:
+    """base 之 detached worktree（接續時沿用同一棵）：HEAD＝base、工作樹乾淨（豁免 data_cache symlink 與 __pycache__）。"""
+    wt = out / f"base_{base[:12]}" / "wt"
+    if not wt.exists():
+        wt.parent.mkdir(parents=True, exist_ok=True)
+        _git_out(root, "worktree", "add", "--detach", str(wt), base)
+    if _git_out(wt, "rev-parse", "HEAD").strip() != base:
+        raise TestregError(f"RUN base worktree {wt} 之 HEAD ≠ {base[:12]}")
+    dirty = [ln for ln in _git_out(wt, "status", "--porcelain").splitlines() if ln.strip() and not g._benign_status(ln)]
+    if dirty:
+        raise TestregError(f"RUN base worktree 不乾淨：{dirty[:5]}")
+    dc = root / "data_cache"
+    if dc.exists() and not (wt / "data_cache").exists():
+        (wt / "data_cache").symlink_to(dc)
+    return wt
+
+
+def _subbatch_inputs_digest(g: Any, root: Path, base: str, head: str, manifest_sha: str, phase: int,
+                            schema: Mapping[str, Any]) -> str:
+    h = hashlib.sha256()
+    for part in (base, head, _git_out(root, "diff", "--binary", "HEAD", "--", ".", *g.FP_EXCLUDES),
+                 g.content_inputs(root), manifest_sha, str(phase),
+                 *(_sha256_file(root / rel) or "<missing>"
+                   for rel in (schema["catalog"]["path"], SCHEMA_REL, "scripts/testreg.py"))):
+        h.update(part.encode("utf-8", "replace"))
+        h.update(b"\0")
+    return h.hexdigest()
+
+
+def _subbatch_relation_errors(r: Mapping[str, Any], collected: Mapping[str, Sequence[str]]) -> List[str]:
+    """契約 `subbatch_gate` 所列欄間關係（寫入前自驗；任一不符 ⇒ 不寫 pass）。"""
+    errs = []
+    sel = [x["path"] for x in r["selection"]["selected"]]
+    if set(r["files"]) != set(sel):
+        errs.append("files 鍵集合 ≠ selection.selected 之 path 集合")
+    if set(r["expected"]) != set().union(*(set(collected.get(p, ())) for p in sel)):
+        errs.append("expected ≠ 選中各檔 collect 所得 nodeid 之聯集")
+    if not set(r["results"]) <= set(r["expected"]):
+        errs.append("results 鍵不 ⊆ expected")
+    if r["missing"] != sorted(n for n in r["expected"] if n not in r["results"]):
+        errs.append("missing ≠ expected 中無 results 者")
+    bad = {n for n, o in r["results"].items() if o != "passed"}
+    if set(r["caused"]) & set(r["head_red"]) or set(r["caused"]) | set(r["head_red"]) != bad:
+        errs.append("caused 與 head_red 須互斥且聯集＝results 中非 passed 者")
+    if r["pass"] != (not r["caused"] and not r["missing"] and not r["incomplete_files"]):
+        errs.append("pass ≠（caused、missing、incomplete_files 皆空）")
+    return errs
+
