+def _receipt_rel(schema: Mapping[str, Any], kind: str, key: str) -> str:
+    """契約 `receipts.<kind>.file_rule`：infrastructure_repair 以函式層 nodeid、additive_rewrite 以測試檔路徑為鍵。"""
+    return f"{schema['receipts'][kind]['dir']}/{key.replace('/', '__').replace('::', '--')}.json"
+
