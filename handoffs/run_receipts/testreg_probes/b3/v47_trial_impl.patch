+def _literal_seq_len(node: Optional[ast.AST]) -> Optional[int]:
+    return len(node.elts) if isinstance(node, (ast.List, ast.Tuple)) else None
+
+
+def _name_literal_len(body: Sequence[ast.stmt], name: str, before: int) -> Optional[int]:
+    """模組層（或類別本體）於 before 行之前最後一次綁定 name 之值為字面 list／tuple ⇒ 其長度；否則 None。"""
+    val: Optional[ast.AST] = None
+    for st in body:
+        if getattr(st, "lineno", 0) >= before:
+            break
+        if isinstance(st, ast.Assign) and any(isinstance(x, ast.Name) and x.id == name for x in st.targets):
+            val = st.value
+        elif isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and st.name == name:
+            val = None
+        elif isinstance(st, (ast.Import, ast.ImportFrom)) and any((a.asname or a.name.split(".")[0]) == name
+                                                                    for a in st.names):
+            val = None
+    return _literal_seq_len(val)
+
+
+def _parametrize_of(marks: Sequence[ast.AST]) -> List[ast.Call]:
+    out = []
+    for d in marks:
+        for x in (d.elts if isinstance(d, (ast.List, ast.Tuple)) else [d]):
+            if isinstance(x, ast.Call) and _last_name(x.func) == "parametrize":
+                out.append(x)
+    return out
+
+
+def _pytestmark_values(body: Sequence[ast.stmt]) -> List[ast.AST]:
+    return [st.value for st in body if isinstance(st, ast.Assign)
+            and any(isinstance(x, ast.Name) and x.id == "pytestmark" for x in st.targets)]
+
+
+def _fixture_param_names(tree: "_Tree", path: str) -> Tuple[set, Dict[str, Any]]:
+    """測試檔與其目錄鏈上 conftest.py 之 fixture（近者覆蓋遠者）：(帶 params 之名, {"deps": 名→其參數名, "auto": autouse 名})。"""
+    files = [path]
+    d = path.rsplit("/", 1)[0] if "/" in path else ""
+    while True:
+        files.append(f"{d}/conftest.py" if d else "conftest.py")
+        if not d:
+            break
+        d = d.rsplit("/", 1)[0] if "/" in d else ""
+    with_params: Dict[str, bool] = {}
+    deps: Dict[str, List[str]] = {}
+    autouse: Dict[str, bool] = {}
+    for f in reversed(files):
+        src = tree.read(f)
+        if src is None:
+            continue
+        try:
+            mod = ast.parse(src)
+        except SyntaxError:
+            continue
+        for n in mod.body:
+            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                isfx, auto = _fixture_info(n)
+                if not isfx:
+                    continue
+                params = any(isinstance(dec, ast.Call) and _last_name(dec.func if isinstance(dec, ast.Call) else dec)
+                             == "fixture" and any(k.arg == "params" for k in dec.keywords) for dec in n.decorator_list)
+                with_params[n.name] = params
+                deps[n.name] = [a.arg for a in n.args.args]
+                autouse[n.name] = auto
+    return {k for k, v in with_params.items() if v}, {"deps": deps, "auto": [k for k, v in autouse.items() if v]}
+
