+def _case_count(tree: "_Tree", nodeid: str) -> Optional[int]:
+    """契約 `receipts.session_scope` ②：靜態列舉函式層 nodeid 之參數案例數；不可列舉 ⇒ None。"""
+    path, qual = _split_nodeid(nodeid)
+    src = tree.read(path)
+    if src is None:
+        return None
+    try:
+        mod = ast.parse(src)
+    except SyntaxError:
+        return None
+    parts = qual.split("::")
+    cls: Optional[ast.ClassDef] = None
+    body: Sequence[ast.stmt] = mod.body
+    if len(parts) == 2:
+        cls = next((n for n in mod.body if isinstance(n, ast.ClassDef) and n.name == parts[0]), None)
+        if cls is None:
+            return None
+        body = cls.body
+    fn = next((n for n in body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == parts[-1]), None)
+    if fn is None:
+        return None
+    layers: List[Tuple[Sequence[ast.AST], Sequence[ast.stmt], int]] = [(fn.decorator_list, mod.body, fn.lineno)]
+    if cls is not None:
+        layers += [(cls.decorator_list, mod.body, cls.lineno), (_pytestmark_values(cls.body), mod.body, cls.lineno)]
+    layers.append((_pytestmark_values(mod.body), mod.body, fn.lineno))
+    total, argnames = 1, set()
+    for marks, scope_body, before in layers:
+        for call in _parametrize_of(marks):
+            names = call.args[0] if call.args else next((k.value for k in call.keywords if k.arg == "argnames"), None)
+            vals = call.args[1] if len(call.args) > 1 else next((k.value for k in call.keywords if k.arg == "argvalues"),
+                                                                 None)
+            if isinstance(names, ast.Constant) and isinstance(names.value, str):
+                argnames |= {x.strip() for x in names.value.split(",") if x.strip()}
+            elif isinstance(names, (ast.List, ast.Tuple)) and all(isinstance(e, ast.Constant) for e in names.elts):
+                argnames |= {str(e.value) for e in names.elts}
+            else:
+                return None
+            k = _literal_seq_len(vals)
+            if k is None and isinstance(vals, ast.Name):
+                k = _name_literal_len(scope_body, vals.id, before)
+            if k is None:
+                return None
+            total *= k
+    param_fx, info = _fixture_param_names(tree, path)
+    deps, todo, seen = info["deps"], [a.arg for a in fn.args.args if a.arg not in ("self", "request")] + info["auto"], set()
+    while todo:
+        name = todo.pop()
+        if name in seen or name in argnames:
+            continue
+        seen.add(name)
+        if name in param_fx:
+            return None
+        todo += deps.get(name, [])
+    return total
+
