+def session_scope_errors(ctx: Context, session_id: str, nodeid: str, tree: Optional["_Tree"] = None) -> List[str]:
+    """契約 `receipts.session_scope`：session 須含函式層 nodeid 之全部參數案例——argv 位置參數含 nodeid／所在檔／上層
+    目錄且無篩選旗標；session 中該目標之紀錄數＝AST 靜態列舉數（不可列舉 ⇒ 不成立）。tree 預設為該 session 之 head。"""
+    sess = _ledger_session(ctx, session_id)
+    if sess is None:
+        return [f"unverifiable：session {session_id} 不在 ledger"]
+    info = sess["session"] or {}
+    try:
+        an = json.loads(info.get("argv_norm") or "{}")
+    except ValueError:
+        an = {}
+    args, opt = an.get("args") or [], an.get("option") or {}
+    path, _q = _split_nodeid(nodeid)
+    errs = []
+
+    def covers(a: str) -> bool:
+        a = a.rstrip("/")
+        return a in ("", ".", nodeid, path) or path.startswith(a + "/")
+
+    if args and not any(covers(str(a)) for a in args):
+        errs.append(f"session 之位置參數 {args[:3]} 未涵蓋 {nodeid} 之全部案例")
+    if opt.get("keyword") or opt.get("markexpr") or opt.get("deselect") or opt.get("lf") or opt.get("stepwise"):
+        errs.append("session 帶篩選旗標（-k／-m／--deselect／--lf／--sw）")
+    e = _case_count(tree if tree is not None else _Tree(ctx.repo_root, f"rev:{info.get('head')}"), nodeid)
+    if e is None:
+        return errs + [f"{nodeid} 之參數案例不可靜態列舉（非字面 argvalues 或 fixture params）"]
+    n = sum(1 for k in sess["tests"] if re.sub(r"\[.*\]$", "", k) == nodeid)
+    if n != e:
+        errs.append(f"session 中 {nodeid} 之紀錄數 {n} ≠ 靜態列舉之案例數 {e}")
+    return errs
+
