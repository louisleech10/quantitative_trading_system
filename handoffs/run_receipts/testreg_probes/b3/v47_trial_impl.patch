+_EXIT_CALLS = frozenset({"exit", "quit"})
+
+
+def _is_exit_stmt(st: ast.stmt) -> bool:
+    """結束類敘述：呼叫 exit／quit／sys.exit／os._exit 之運算式敘述、raise SystemExit…、本體與 else 皆只含結束類之 if。"""
+    if isinstance(st, ast.Expr) and isinstance(st.value, ast.Call):
+        f = st.value.func
+        if isinstance(f, ast.Name) and f.id in _EXIT_CALLS:
+            return True
+        if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name) and \
+                (f.value.id, f.attr) in (("sys", "exit"), ("os", "_exit")):
+            return True
+    if isinstance(st, ast.Raise) and st.exc is not None:
+        exc = st.exc.func if isinstance(st.exc, ast.Call) else st.exc
+        return _last_name(exc) == "SystemExit"
+    if isinstance(st, ast.If):
+        return bool(st.body) and all(_is_exit_stmt(x) for x in st.body) and all(_is_exit_stmt(x) for x in st.orelse)
+    return False
+
+
+def _is_main_guard(st: ast.stmt) -> bool:
+    t = getattr(st, "test", None)
+    return isinstance(st, ast.If) and isinstance(t, ast.Compare) and isinstance(t.left, ast.Name) and \
+        t.left.id == "__name__" and len(t.comparators) == 1 and isinstance(t.comparators[0], ast.Constant) and \
+        t.comparators[0].value == "__main__"
+
+
+def _is_module_exec(st: ast.stmt, first: bool) -> bool:
+    """G-c 之模組層可執行敘述（import／def／class／首句 docstring／純字面賦值／__main__ 區塊以外者）。"""
+    if isinstance(st, (ast.Import, ast.ImportFrom, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+        return False
+    if first and isinstance(st, ast.Expr) and isinstance(st.value, ast.Constant) and isinstance(st.value.value, str):
+        return False
+    if isinstance(st, ast.Assign) and _pure_literal(st.value):
+        return False
+    return not _is_main_guard(st)
+
+
+def _added_ok(st: ast.stmt, fp_: Sequence[str], cp_: Sequence[str]) -> bool:
+    """純增之結構白名單：import、測試函式（非 fixture）、無裝飾器且只含 docstring 與測試方法之測試類別。"""
+    def test_fn(n: ast.AST) -> bool:
+        return isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and _name_ok(n.name, fp_) and \
+            not _fixture_info(n)[0]
+    if isinstance(st, (ast.Import, ast.ImportFrom)):
+        return True
+    if test_fn(st):
+        return True
+    if isinstance(st, ast.ClassDef) and _name_ok(st.name, cp_) and not st.decorator_list:
+        return all(test_fn(x) or (i == 0 and isinstance(x, ast.Expr) and isinstance(x.value, ast.Constant))
+                   for i, x in enumerate(st.body))
+    return False
+
+
+def _prod_symbols(eng: "_Engine", path: str, fn: ast.AST, roots: Tuple[str, ...]) -> set:
+    """函式本體（含遞移呼叫之同模組非測試函式、函式內匯入）以 Name／Attribute 載入、經匯入解析至 production_roots 下
+    模組之符號（模組檔, 名稱）。"""
+    mi = eng.mod(path)
+    if mi is None:
+        return set()
+    out, seen, todo = set(), set(), [fn]
+    while todo:
+        node = todo.pop()
+        local: Dict[str, Tuple[str, str, Optional[str]]] = {}
+        for n in ast.walk(node):
+            if isinstance(n, (ast.Import, ast.ImportFrom)):
+                _note_imports(n, local, path)
+        binds = {**mi.imports, **local}
+        for n in ast.walk(node):
+            chain: List[str] = []
+            x: ast.AST = n
+            if isinstance(n, ast.Attribute):
+                while isinstance(x, ast.Attribute):
+                    chain.insert(0, x.attr)
+                    x = x.value
+            if not isinstance(x, ast.Name) or not isinstance(x.ctx, ast.Load):
+                continue
+            b = binds.get(x.id)
+            if b is None:
+                if not chain and x.id in mi.defs and x.id not in seen and not _fixture_info(mi.defs[x.id])[0]:
+                    seen.add(x.id)
+                    todo.append(mi.defs[x.id])
+                continue
+            mod = b[1] if b[0] == "module" else f"{b[1]}.{b[2]}"
+            mp = eng.module_path(mod)
+            if b[0] == "from" and mp is None:  # from M import f：f 為 M 之屬性
+                mp2 = eng.module_path(b[1])
+                if mp2 and mp2.startswith(roots):
+                    out.add((mp2, b[2]))
+                continue
+            while chain and mp is not None and eng.module_path(f"{mod}.{chain[0]}"):
+                mod = f"{mod}.{chain.pop(0)}"
+                mp = eng.module_path(mod)
+            if mp and mp.startswith(roots) and chain:
+                out.add((mp, chain[0]))
+    return out
+
+
+def additive_rewrite_errors(ctx: Context, path: str) -> Optional[List[str]]:
+    """契約 `receipts.additive_rewrite`（SPEC v47 G-b／G-c，檔級）：純增改寫收據。無收據 ⇒ None；有 ⇒ 不符清單。"""
+    s, t = ctx.schema, _tree(ctx)
+    rel = _receipt_rel(s, "additive_rewrite", path)
+    text = t.read(rel)
+    if text is None:
+        return None
+    try:
+        r = json.loads(text)
+    except ValueError:
+        return ["純增改寫收據非 JSON"]
+    errs = list(_seam("validate_shape")(r, {"type": "types.receipt_additive_rewrite"}, s))
+    if errs:
+        return errs
+    if r["path"] != path:
+        errs.append(f"收據 path {r['path']} ≠ {path}")
+    e = _entries(ctx).get(path)
+    if not isinstance(e, dict) or e.get("disposition") != "rewrite":
+        errs.append("path 須為 disposition＝rewrite 之 entry")
+    hp = _receipt_head_problem(ctx, rel, r["head"])
+    if hp:
+        errs.append(hp)
+    ap = ctx.repo_root / r["approval_ref"]
+    if not ap.is_file() or path not in ap.read_text(encoding="utf-8", errors="replace"):
+        errs.append("approval_ref 不存在或未引用 path")
+    head_eng = _engine_for(ctx, f"rev:{r['head']}")
+    head_src, cur_src = head_eng.tree.read(path), t.read(path)
+    cp = r["compare_patch_path"]
+    ptext = t.read(cp)
+    if ptext is None or hashlib.sha256(ptext.encode("utf-8")).hexdigest() != r["compare_patch_sha256"]:
+        return errs + ["compare_patch 不存在或 sha256 不符"]
+    if set(_patch_paths(ptext)) != {path}:
+        errs.append("compare_patch 所及之檔須恰為 path")
+    patched = _PatchedTree(ctx, r["head"], cp).read(path)
+    if patched is None or patched != cur_src or head_src is None:
+        return errs + ["compare_patch 套於 head 後 ≠ 受驗之樹之 path"]
+    fp_, cp_, _f, _t = _collect_patterns(t)
+    head_fns, cur_fns = _test_functions(head_src, fp_, cp_), _test_functions(cur_src, fp_, cp_)
+    for q, n in head_fns.items():
+        if q not in cur_fns:
+            errs.append(f"舊函式 {q} 被刪或改名")
+        elif ast.dump(n) != ast.dump(cur_fns[q]):
+            errs.append(f"舊函式 {q} 已改動（須一字不動）")
+    added = sorted(f"{path}::{q}" for q in set(cur_fns) - set(head_fns))
+    if not added or set(r["added_nodeids"]) != set(added):
+        errs.append(f"added_nodeids 須恰為新增之函式層 nodeid 全集 {added}")
+    hmod, cmod = ast.parse(head_src), ast.parse(cur_src)
+    gc = not head_fns
+    keep = [st for i, st in enumerate(hmod.body) if not (gc and _is_module_exec(st, i == 0))]
+    i = 0
+    added_nodes: List[ast.AST] = []
+    for st in cmod.body:
+        if i < len(keep) and ast.dump(st) == ast.dump(keep[i]):
+            i += 1
+            continue
+        if _added_ok(st, fp_, cp_):
+            if not isinstance(st, (ast.Import, ast.ImportFrom)):
+                added_nodes.append(st)
+            continue
+        errs.append(f"結構白名單外之模組層敘述（第 {st.lineno} 行；只准新增 import、測試函式、只含測試方法之測試類別）")
+    if i != len(keep):
+        errs.append("head 之模組層敘述被刪除或改動（結構須只增）")
+    bodies: List[ast.stmt] = []
+    for n in added_nodes:
+        for fn in ([n] if not isinstance(n, ast.ClassDef) else [x for x in n.body if not isinstance(x, ast.Expr)]):
+            bodies += fn.body
+            if any(_is_exit_stmt(x) for x in ast.walk(fn) if isinstance(x, ast.stmt)):
+                errs.append(f"新增函式 {fn.name} 含結束類敘述（exit／SystemExit；須以斷言取代）")
+    if gc:
+        need = [ast.dump(st) for k, st in enumerate(hmod.body) if _is_module_exec(st, k == 0) and not _is_exit_stmt(st)]
+        it = iter(ast.dump(x) for x in bodies)
+        if not all(any(d == y for y in it) for d in need):
+            errs.append("G-c：head 之模組層可執行敘述未依序搬入新增函式本體")
+    overlay = _OverlayTree(ctx.repo_root, r["head"], {path: cur_src})
+    oeng = _Engine(overlay)
+    for a in added:
+        if not oeng.elements(a):
+            errs.append(f"新增函式 {a} 無斷言")
+    dcs: set = set()
+
+    def bound(sid: str, patches: List[str], label: str) -> Optional[Dict[str, Any]]:
+        sess = _ledger_session(ctx, sid)
+        if sess is None:
+            errs.append(f"unverifiable：{label} 之 session {sid} 不在 ledger")
+            return None
+        info = sess["session"] or {}
+        dcs.add(info.get("duration_class"))
+        if info.get("head") != r["head"] or info.get("diff_digest") != _digest_with(ctx, r["head"], patches):
+            errs.append(f"{label} 之 session 不綁定 head＋補丁")
+        return sess
+
+    base = bound(r["baseline_session_id"], [cp], "baseline")
+    for a in added:
+        recs = [x for k, x in (base or {"tests": {}})["tests"].items() if re.sub(r"\[.*\]$", "", k) == a]
+        if not recs or any(x.get("outcome") != "passed" for x in recs):
+            errs.append(f"baseline session 中 {a} 未全過")
+        errs += [f"baseline 之 session 不合全案例：{x}"
+                 for x in _seam("session_scope_errors")(ctx, r["baseline_session_id"], a, overlay)]
+    roots = tuple(s["receipts"]["E0"]["production_roots"])
+    killers: List[Tuple[Dict[str, Any], set]] = []
+    kills: Dict[str, List[Tuple[Any, Any]]] = {a: [] for a in added}
+    for m in r["mutants"]:
+        label = f"mutant {m['id']}"
+        mp = t.read(m["patch_path"])
+        if mp is None or hashlib.sha256(mp.encode("utf-8")).hexdigest() != m["patch_sha256"]:
+            errs.append(f"{label} 補丁不存在或 sha256 不符")
+            continue
+        mfiles = set(_patch_paths(mp))
+        if any(not p.startswith(roots) for p in mfiles):
+            errs.append(f"{label} 修改 production_roots 以外之檔")
+            continue
+        sm = bound(m["session_id"], [cp, m["patch_path"]], label)
+        if sm is None:
+            continue
+        killed = False
+        for a in added:
+            errs += [f"{label} 之 session 不合全案例：{x}"
+                     for x in _seam("session_scope_errors")(ctx, m["session_id"], a, overlay)]
+            mr = _fn_record(sm, a)
+            if mr is not None and mr["outcome"] in ("failed", "error"):
+                apath = a.split("::")[0]
+                loc = next((f for f in mr.get("fail_frames", []) if f.rsplit(":", 1)[0] == apath), None)
+                kills[a].append((loc, mr))
+                killed = True
+        if killed:
+            killers.append((m, mfiles))
+    for a in added:
+        errs += _kill_errors(ctx, a, oeng.elements(a), kills[a], "新增")
+    if not gc:
+        cov = _covered(ctx, e) if isinstance(e, dict) else []
+        targets = [n for n in cov if _split_nodeid(n)[1] in head_fns] if (e or {}).get("rewrite_targets") else \
+            [f"{path}::{q}" for q in head_fns]
+        radd: set = set()
+        for a in added:
+            fn_a = _test_functions(cur_src, fp_, cp_).get(_split_nodeid(a)[1])
+            if fn_a is not None:
+                radd |= _prod_symbols(oeng, path, fn_a, roots)
+        for tg in targets:
+            rt = _prod_symbols(head_eng, path, head_fns[_split_nodeid(tg)[1]], roots)
+            if not rt:
+                errs.append(f"情境綁定：舊目標 {tg} 未引用任何生產符號（本收據不適用）")
+                continue
+            miss = sorted(rt - radd)
+            if miss:
+                errs.append(f"情境綁定：新增函式未引用舊目標 {tg} 之生產符號 {miss}")
+            mods = {mp_ for mp_, _n in rt}
+            if not any(mfiles & mods for _m, mfiles in killers):
+                errs.append(f"情境綁定：無殺 mutant 改動舊目標 {tg} 引用符號之定義檔 {sorted(mods)}")
+    if None in dcs or len(dcs) > 1 or (dcs and r["fingerprint"] not in dcs):
+        errs.append("各 session 之 duration_class 不一或不等於 fingerprint")
+    return errs
 
 
