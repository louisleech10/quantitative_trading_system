+def _kill_errors(ctx: Context, nodeid: str, els: Sequence[Mapping[str, Any]], kills: Sequence[Tuple[Any, Any]],
+                 label: str) -> List[str]:
+    """每一斷言元素之殺點（phase 與 frame 規定同 receipts.mutation.rule）。kills＝[(target_fail_loc, 紀錄)]。"""
+    errs = []
+    for e in els:
+        f, elo, ehi = e["prov"]
+        owner = e.get("owner") or (f, elo, ehi, "helper")
+        hit = False
+        for loc, mr in kills:
+            if not loc or loc.rsplit(":", 1)[0] != f or not elo <= int(loc.rsplit(":", 1)[1]) <= ehi:
+                continue
+            if owner[3] == "fixture":
+                hit = mr["phase_failed"] in ("setup", "teardown") and _frame_in(mr, owner[0], owner[1], owner[2])
+            else:
+                hit = mr["phase_failed"] == "call" and _frame_in(mr, owner[0], owner[1], owner[2])
+            if hit:
+                break
+        if not hit:
+            errs.append(f"{label}斷言 {f}:{elo} 無對應之殺 mutant")
+    return errs
+
