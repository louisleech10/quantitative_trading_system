+def defective_rewrite_receipt_rel(schema: Mapping[str, Any], nodeid: str) -> str:
+    """契約 `receipts.defective_rewrite.file_rule`：函式層 nodeid 之缺陷目標改寫收據之 repo 相對路徑。"""
+    return f"{schema['receipts']['defective_rewrite']['dir']}/{nodeid.replace('/', '__').replace('::', '--')}.json"
+
+
+class _OverlayTree(_Tree):
+    """rev:<head> 之樹，另以 overrides（路徑→內容）覆蓋（改寫後函式之斷言於 head＋compare_patch 之樹重算）。"""
+
+    def __init__(self, root: Path, rev: str, overrides: Mapping[str, str]):
+        super().__init__(root, f"rev:{rev}")
+        self._cache.update(overrides)
+
+
+def _frame_in(tr: Mapping[str, Any], f: str, lo: int, hi: int) -> bool:
+    return any(fr.rsplit(":", 1)[0] == f and lo <= int(fr.rsplit(":", 1)[1]) <= hi for fr in tr.get("fail_frames", []))
+
+
+def _prov_key(e: Mapping[str, Any]) -> Optional[str]:
+    return f"{e['prov'][0]}:{e['prov'][1]}" if e.get("prov") else None
+
+
+def defective_rewrite_errors(ctx: Context, nodeid: str) -> Optional[List[str]]:
+    """契約 `receipts.defective_rewrite`（SPEC v44 Task 3.0）：函式層 nodeid 之缺陷目標改寫收據。無收據 ⇒ None；有 ⇒
+    不符之清單（空＝成立，該函式之 V19 放行、V07／V21 認可）。kind=existing_red：HEAD 上目標於 call 期失敗於
+    defect_lines 之斷言、bisect 好壞提交祖先關係與紀錄檔；kind=vacuous：survivor 下目標全過而改寫後函式於新增或改變之
+    斷言失敗、每一 defect_line 皆有成立之 survivor。兩者共同：compare_patch 只改目標所在檔且套用後函式＝受驗版、baseline
+    全過、改寫後函式每一斷言元素皆有殺 mutant（phase／frame 規定同 receipts.mutation）、斷言差限於 defect_lines、各
+    session 綁定 head＋補丁且 duration_class 一致＝fingerprint。"""
+    s = ctx.schema
+    t = _tree(ctx)
+    rel = defective_rewrite_receipt_rel(s, nodeid)
+    text = t.read(rel)
+    if text is None:
+        return None
+    try:
+        r = json.loads(text)
+    except ValueError:
+        return ["缺陷目標改寫收據非 JSON"]
+    errs = list(_seam("validate_shape")(r, {"type": "types.receipt_defective_rewrite"}, s))
+    if errs:
+        return errs
+    if r["target_nodeid"] != nodeid:
+        errs.append(f"收據 target_nodeid {r['target_nodeid']} ≠ {nodeid}")
+    hp = _receipt_head_problem(ctx, rel, r["head"])
+    if hp:
+        errs.append(hp)
+    if not (ctx.repo_root / r["approval_ref"]).is_file():  # 收斂檔依慣例不進 git
+        errs.append(f"approval_ref {r['approval_ref']} 不存在")
+    path, qual = _split_nodeid(nodeid)
+    head_eng = _engine_for(ctx, f"rev:{r['head']}")
+    if nodeid not in _function_nodeids(head_eng.tree, path) or nodeid not in _function_nodeids(t, path):
+        return errs + ["目標函式不存在於 head 或受驗之樹"]
+    old_els = head_eng.elements(nodeid)
+    old_prov = {_prov_key(e) for e in old_els} - {None}
+    defect = set(r["defect_lines"])
+    if not defect <= old_prov:
+        errs.append(f"defect_lines 非目標於 head 之斷言位置：{sorted(defect - old_prov)[:3]}")
+    cp = r["compare_patch_path"]
+    ptext = t.read(cp)
+    if ptext is None or hashlib.sha256(ptext.encode("utf-8")).hexdigest() != r["compare_patch_sha256"]:
+        return errs + ["compare_patch 不存在或 sha256 不符"]
+    if set(_patch_paths(ptext)) != {path}:
+        errs.append("compare_patch 所及之檔須恰為目標所在測試檔")
+    patched = _PatchedTree(ctx, r["head"], cp).read(path)
+    if patched is None:
+        return errs + ["compare_patch 套於 head 失敗"]
+    a, b = _test_functions(patched).get(qual), _test_functions(t.read(path)).get(qual)
+    if a is None or b is None or ast.dump(a) != ast.dump(b):
+        errs.append("compare_patch 套用後之目標函式與受驗之樹不同")
+    new_els = _Engine(_OverlayTree(ctx.repo_root, r["head"], {path: patched})).elements(nodeid)
+    if not new_els:
+        return errs + ["改寫後函式無斷言元素（不得用本收據）"]
+    old_keys = collections.Counter(e["key"] for e in old_els)
+    defect_keys = collections.Counter(e["key"] for e in old_els if _prov_key(e) in defect)
+    over = (old_keys - collections.Counter(e["key"] for e in new_els)) - defect_keys
+    if over:
+        errs.append(f"斷言差含 defect_lines 以外之元素 {sum(over.values())} 項")
+    roots = tuple(s["receipts"]["E0"]["production_roots"])
+    dcs: set = set()
+
+    def bound(sid: str, patches: List[str], label: str) -> Optional[Dict[str, Any]]:
+        sess = _ledger_session(ctx, sid)
+        if sess is None:
+            errs.append(f"unverifiable：{label} 之 session {sid} 不在 ledger")
+            return None
+        info = sess["session"] or {}
+        dcs.add(info.get("duration_class"))
+        if info.get("head") != r["head"] or info.get("diff_digest") != _digest_with(ctx, r["head"], patches):
+            errs.append(f"{label} 之 session 不綁定 head＋補丁")
+        return sess
+
+    def patch_ok(item: Mapping[str, Any], label: str) -> bool:
+        pt = t.read(item["patch_path"])
+        if pt is None or hashlib.sha256(pt.encode("utf-8")).hexdigest() != item["patch_sha256"]:
+            errs.append(f"{label} 補丁不存在或 sha256 不符")
+            return False
+        if any(not p.startswith(roots) for p in _patch_paths(pt)):
+            errs.append(f"{label} 修改 production_roots 以外之檔")
+            return False
+        return True
+
+    def all_passed(sess: Optional[Mapping[str, Any]]) -> bool:
+        recs = [x for n_, x in (sess or {"tests": {}})["tests"].items() if re.sub(r"\[.*\]$", "", n_) == nodeid]
+        return bool(recs) and all(x.get("outcome") == "passed" for x in recs)
+
+    if not all_passed(bound(r["compare_baseline_session_id"], [cp], "compare_baseline")):
+        errs.append("改寫後函式於 baseline session 未全過")
+    if r["kind"] == "existing_red":
+        if r["survivors"]:
+            errs.append("existing_red 之 survivors 須為空")
+        need = ("first_bad_commit", "good_commit", "bisect_log_path", "target_session_id")
+        if any(r[k] is None for k in need):
+            errs.append("existing_red 缺 bisect 或 target session 欄")
+        else:
+            if r["good_commit"] == r["first_bad_commit"] or not _is_ancestor(ctx.repo_root, r["good_commit"],
+                                                                              r["first_bad_commit"]):
+                errs.append("good_commit 須為 first_bad_commit 之祖先且互異")
+            if not t.exists(r["bisect_log_path"]):
+                errs.append(f"bisect_log_path {r['bisect_log_path']} 不存在")
+            ts = bound(r["target_session_id"], [], "target")
+            tr = _fn_record(ts, nodeid) if ts is not None else None
+            if tr is None or tr["outcome"] not in ("failed", "error") or tr.get("phase_failed") != "call":
+                errs.append("目標於 head 未於 call 期失敗（非既有紅）")
+            elif not any(_frame_in(tr, *e["prov"]) for e in old_els if _prov_key(e) in defect):
+                errs.append("目標之失敗位置不在 defect_lines 所屬斷言")
+    else:
+        if any(r[k] is not None for k in ("first_bad_commit", "good_commit", "bisect_log_path", "target_session_id")):
+            errs.append("vacuous 之 bisect 與 target session 欄須為 null")
+        covered = set()
+        for sv in r["survivors"]:
+            label = f"survivor {sv['id']}"
+            if not patch_ok(sv, label):
+                continue
+            ok1 = all_passed(bound(sv["session_id"], [sv["patch_path"]], label))
+            s2 = bound(sv["compare_session_id"], [cp, sv["patch_path"]], label)
+            cr = _fn_record(s2, nodeid) if s2 is not None else None
+            ok2 = (cr is not None and cr["outcome"] in ("failed", "error") and cr.get("phase_failed") == "call"
+                   and any(_frame_in(cr, *e["prov"]) for e in new_els if old_keys[e["key"]] == 0))
+            if not ok1:
+                errs.append(f"{label} 下目標未全過（非空心證據）")
+            if not ok2:
+                errs.append(f"{label} 下改寫後函式未於新增或改變之斷言失敗")
+            if ok1 and ok2:
+                covered.add(sv["defect_line"])
+        if not r["survivors"]:
+            errs.append("vacuous 須至少一個 survivor")
+        if defect - covered:
+            errs.append(f"defect_lines 無成立之 survivor：{sorted(defect - covered)[:3]}")
+    kills = []
+    files = {e["prov"][0] for e in new_els}
+    for m in r["mutants"]:
+        label = f"mutant {m['id']}"
+        if not patch_ok(m, label):
+            continue
+        if m["session_id"] != m["compare_session_id"] or set(m["compare_outcomes"]) != {nodeid}:
+            errs.append(f"{label} 之 session 或 compare_outcomes 不合（須同一 session、鍵＝目標）")
+        sm = bound(m["session_id"], [cp, m["patch_path"]], label)
+        tr = _fn_record(sm, nodeid) if sm is not None else None
+        if tr is None:
+            errs.append(f"{label} 之 session 無目標紀錄")
+            continue
+        loc = next((f for f in tr.get("fail_frames", []) if f.rsplit(":", 1)[0] in files), None)
+        if tr["outcome"] != m["target_outcome"] or loc != m["target_fail_loc"] or \
+                tr["outcome"] != m["compare_outcomes"].get(nodeid):
+            errs.append(f"{label} 之結果與紀錄不符")
+        if tr["outcome"] in ("failed", "error"):
+            kills.append((m, tr))
+    for e in new_els:
+        f, lo, hi = e["prov"]
+        owner = e.get("owner") or (f, lo, hi, "helper")
+        ok = False
+        for m, tr in kills:
+            loc = m["target_fail_loc"]
+            if not loc or loc.rsplit(":", 1)[0] != f or not lo <= int(loc.rsplit(":", 1)[1]) <= hi:
+                continue
+            if owner[3] == "fixture":
+                ok = tr["phase_failed"] in ("setup", "teardown") and _frame_in(tr, owner[0], owner[1], owner[2])
+            else:
+                ok = tr["phase_failed"] == "call" and _frame_in(tr, owner[0], owner[1], owner[2])
+            if ok:
+                break
+        if not ok:
+            errs.append(f"改寫後斷言 {f}:{lo} 無對應之殺 mutant")
+    if None in dcs or len(dcs) > 1 or (dcs and r["fingerprint"] not in dcs):
+        errs.append("各 session 之 duration_class 不一或不等於 fingerprint")
+    return errs
+
+
+def _defective_all_ok(ctx: Context, entry: Mapping[str, Any]) -> bool:
+    """v44：rewrite_targets 所涵蓋之每一函式層 nodeid 皆有成立之缺陷目標改寫收據。"""
+    cov = _covered(ctx, entry)
+    return bool(cov) and all(_seam("defective_rewrite_errors")(ctx, n) == [] for n in cov)
+
