+def _frame_in(tr: Mapping[str, Any], f: str, lo: int, hi: int) -> bool:
+    return any(fr.rsplit(":", 1)[0] == f and lo <= int(fr.rsplit(":", 1)[1]) <= hi for fr in tr.get("fail_frames", []))
