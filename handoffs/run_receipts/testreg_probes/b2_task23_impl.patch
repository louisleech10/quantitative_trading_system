+# ── TESTREG Task 2.3：隔離失敗（契約 tests/registry/testreg_schema.json `gate_report`）──────────────────────────────
+QUARANTINE_FIELDS = ("exception_type", "exception_head", "exception_origin", "fail_line")
+
