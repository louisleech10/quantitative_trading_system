 import pytest
 import time
+from pathlib import Path
 from fastapi.testclient import TestClient
 
 from api.main import app
+from api.routes import feature_engineering as fe_routes
+from momentum.FeatureEngineering.feature_storage import FeatureStorage
+from tests._nocap_wait import ProgressWait
 
 
 client = TestClient(app)
 
+# 產品預設輸出根目錄（FeatureStorage 預設 base_path）；本檔測試不得寫入（測試產物一律寫 tmp）
+_REAL_FEATURES_DIR = Path(__file__).resolve().parents[2] / "data_cache" / "features"
+
+
+def _features_snapshot() -> dict:
+    """產品輸出根目錄頂層之 {檔名: (大小, mtime_ns)}（目錄不存在 ⇒ 空）。"""
+    if not _REAL_FEATURES_DIR.is_dir():
+        return {}
+    return {p.name: (p.stat().st_size, p.stat().st_mtime_ns) for p in _REAL_FEATURES_DIR.iterdir()}
+
+
+def _wait_running_tasks() -> None:
+    """等本檔啟動之背景提取任務結束（未等待之任務會於後續測試期間才寫檔），不設上限（NOCAP：卡死由共用監看依進度
+    判定並留堆疊）。產品碼未保留 asyncio.create_task 之 task 物件（api/services/feature_task_service.py），只能輪詢
+    task_manager 之狀態。結束後任何非 completed 之終態（failed 等）照實報出。"""
+    tm = fe_routes.feature_service.task_manager
+    waiter = ProgressWait("feature_api 背景任務")
+    while any(t.get("status") == "running" for t in list(tm.tasks.values())):
+        waiter.check({k: (t.get("status"), t.get("progress")) for k, t in list(tm.tasks.items())})
+        time.sleep(0.2)
+    bad = {k: (t.get("status"), t.get("error")) for k, t in list(tm.tasks.items()) if t.get("status") != "completed"}
+    assert not bad, f"背景特徵提取任務未以 completed 結束：{bad}"
+
+
+@pytest.fixture(scope="module", autouse=True)
+def _feature_storage_in_tmp(tmp_path_factory):
+    """路由層 singleton 之特徵儲存改指 tmp（產品預設 data_cache/features）；模組結束前等背景任務寫完才還原。"""
+    before = _features_snapshot()
+    mp = pytest.MonkeyPatch()
+    mp.setattr(fe_routes.feature_service, "storage",
+               FeatureStorage(base_path=str(tmp_path_factory.mktemp("feature_api_out"))))
+    yield before
+    try:
+        _wait_running_tasks()
+    finally:
+        mp.undo()
+
 
