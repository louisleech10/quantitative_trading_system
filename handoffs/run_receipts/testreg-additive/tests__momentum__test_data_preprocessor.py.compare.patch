+def test_preprocess_full_sample_clips_to_full_period_quantiles_single_outlier():
+    """TESTREG 4.2 純增：outlier 少於 1%（1／200）⇒ 全期 p99 < 1e6，上界裁尾才有鑑別力。
+
+    oracle＝獨立以 pandas 對**全期**原值算 p01／p99 後逐值 clip；未裁上界或改走 PIT
+    （warmup 不裁、早期以早期分位裁）皆與之不符。
+    """
+    rng = np.random.default_rng(0)
+    n = 200
+    values = rng.normal(size=n)
+    values[-1] = 1e6
+    preprocessor = DataPreprocessor(
+        {
+            "winsorization": {
+                "enabled": True,
+                "method": "percentile",
+                "lower_percentile": 1.0,
+                "upper_percentile": 99.0,
+            },
+            "missing_values": {"max_fill_forward": 0, "min_coverage": 0.0},
+            "standardize": {"method": "none"},
+        }
+    )
+    out, log = preprocessor.preprocess(pd.DataFrame({"x": values}), fit_mode="full_sample")
+    raw = pd.Series(values)
+    p01, p99 = float(raw.quantile(0.01)), float(raw.quantile(0.99))
+    expected = np.minimum(np.maximum(values, p01), p99)
+    assert p99 < 1e6 and np.allclose(out["x"].to_numpy(), expected, rtol=0, atol=1e-12) and float(out["x"].max()) == pytest.approx(p99)
